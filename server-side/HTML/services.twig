            <span>Snapchat</span>
          </button>

          <button class="svc-platform-tab" role="tab" data-filter-platform="Google" aria-selected="false">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z"/></svg>
            <span>Google</span>
          </button>

          <button class="svc-platform-tab" role="tab" data-filter-platform="__other__" aria-selected="false">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
            <span>Other</span>
          </button>

          <button class="svc-platform-tab svc-toggle-btn" id="svc-less-toggle">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 15l-6-6-6 6"/></svg>
            <span>Less</span>
          </button>

        </div>{# /svc-more-panel #}

      </div>{# /svc-tabs-grid #}
    </div>{# /svc-filter-section #}

    {# Hidden original dropdown — keeps Perfect Panel category-filter JS working #}
    <div aria-hidden="true" style="display:none">
      <ul class="nav nav-pills services-toolbar-left">
        <li>
          <div class="dropdown">
            <button class="btn btn-secondary dropdown-toggle services-filter-btn" data-toggle="dropdown">
              <span class="services-filter-label" data-filter-default-label="{{ lang('services.all') }}">
                <span class="services-filter-default">{{ lang('services.all') }}</span>
                <span data-filter-active-category="true"></span>
              </span>
            </button>
            <ul class="dropdown-menu dropdown-max-height">
              {% if serviceCategoryList is not empty %}
                <li><a class="dropdown-item" href="#" data-filter-category-id="All">{{ lang('services.all') }}</a></li>
              {% endif %}
              {% if user.favorite_services %}
                <li>
                  <a class="dropdown-item" href="#" data-filter-category-id="favorites" data-filter-category-name="{{ lang('services.favorite') }}">
                    <span>{{ lang('services.favorite') }}</span>
                  </a>
                </li>
              {% endif %}
              <li class="dropdown-platform-divider" style="display:none"><span class="dropdown-divider-label">Platforms</span></li>
              <li id="dropdown-platform-items" style="display:none"></li>
              <li class="dropdown-cat-divider" style="display:none"><span class="dropdown-divider-label">Categories</span></li>
              {% for category in serviceCategoryList %}
                {% if category.name %}
                  <li>
                    <a class="dropdown-item" href="#" data-filter-category-id="{{ category.id }}" data-filter-category-name="{{ category.name }}">
                      {% if category['icon'] %}
                        {% set categoryIcon = category['icon'] %}
                        {% if categoryIcon['icon_type'] == 'icon' %}
                          <span class="cat-icon {{ categoryIcon['icon'] }}"></span>
                        {% elseif categoryIcon['icon_type'] == 'emoji' %}
                          <span class="cat-icon">{{ categoryIcon['icon'] }}</span>
                        {% elseif categoryIcon['icon_type'] == 'image' %}
                          <img src="{{ categoryIcon['url'] }}" alt="{{ category['name'] }}" class="cat-icon-img">
                        {% endif %}
                      {% endif %}
                      <span>{{ category['name'] }}</span>
                    </a>
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          </div>
        </li>
      </ul>
    </div>{# /hidden dropdown #}

    {# ─── Services table ─── #}
    <div class="card services-card">
      {# Search — below tabs #}
      <div class="svc-search-wrap">
        <div class="svc-search">
          <svg class="svc-search__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          <input type="text" class="svc-search__input" placeholder="{{ lang('general.search.placeholder') }}" data-search-service="#service-table" autocomplete="off" aria-label="{{ lang('general.search.placeholder') }}">
        </div>

        {% if site.currencies and not user['auth'] %}
          <div class="dropdown svc-currency-dropdown" style="display:none;">
            <button class="btn btn-secondary dropdown-toggle" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v10"/><path d="M9 10h4a2 2 0 0 1 0 4H9"/></svg>
              <span>{% if user.currency %}{{ user.currency.label }}{% else %}{{ site.currency.label }}{% endif %}</span>
              <span class="caret"></span>
            </button>
            <ul class="dropdown-menu dropdown-max-height" id="currencies-list">
              {% for key, rate in site.currencies %}
                <li>
                  <a class="dropdown-item" href="#" id="currencies-item" data-rate-key="{{ key }}" data-rate-symbol="{{ rate.symbol }}">
                    <span class="tabular">{{ key }}</span><span class="muted">{{ rate.symbol }}</span>
                  </a>
                </li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      </div>
      <div class="table-responsive">
        <table class="table ord-table services-table {% if site['rtl'] %}rtl-table{% endif %}" id="service-table">
          {# Column widths defined here so the layout doesn't shift when the
             accordion opens (category-header-only state has no body cells to
             anchor column widths to). #}
          <colgroup>
            {% if user.favorite_services %}<col class="col-fav">{% endif %}
            <col class="col-id">
            <col class="col-svc-name">
            <col class="col-rate">
            <col class="col-min">
            <col class="col-max">
            {% if site['average_time'] %}<col class="col-avg">{% endif %}
            {% if serviceDescription %}<col class="col-desc hidden-xs hidden-sm">{% endif %}
            <col class="col-order">
          </colgroup>
          <thead>
            <tr>
              {# Empty fav header — body rows carry the toggleable star, matching the empty-utility-header pattern used by orders/subscriptions. #}
              {% if user.favorite_services %}<th class="col-fav" scope="col" aria-label="{{ lang('services.favorite') }}"></th>{% endif %}
              <th class="col-id" scope="col">{{ lang('services.id') }}</th>
              <th class="col-svc-name" scope="col">{{ lang('services.name') }}</th>
              <th class="nowrap col-min" scope="col">Min / Max</th>
              <th class="nowrap col-rate" scope="col"><b>Cost per K</b></th>
              {% if site['average_time'] %}
                <th class="nowrap col-avg" scope="col">
                  {{ lang('services.average_time') }}
                  <span class="info-tip" data-toggle="tooltip" data-placement="top" title="{{ lang('services.average_time.description') }}">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v.01"/><path d="M12 12v4"/></svg>
                  </span>
                </th>
              {% endif %}
              {% if serviceDescription %}
                <th class="hidden-xs hidden-sm service-description__th col-desc" scope="col"><b>{{ lang('services.description') }}</b></th>
              {% endif %}
              {# Empty action header — matches the convention used by orders/subscriptions tables. #}
              <th class="col-order" scope="col" aria-label="{{ lang('services.order') }}"></th>
            </tr>
          </thead>
          <tbody>
            {% for category in serviceCategoryList %}
              {% if category['name'] %}
                <tr class="services-cat-row" data-filter-table-category-id="{{ category.id }}">
                  <td colspan="100%">
                    <div class="services-cat-head">
                      {% set _cn = category['name']|lower %}
                      {% if 'instagram' in _cn %}
                        <img src="https://storage.perfectcdn.com/aedutt/z8guwg1zkq1n6gsl.jpg" alt="{{ category['name'] }}" width="36" height="36" class="cat-icon-img" loading="lazy">
                      {% elseif 'telegram' in _cn %}
                        <img src="https://storage.perfectcdn.com/aedutt/lzzmpkm3r20y1s8j.jpg" alt="{{ category['name'] }}" width="36" height="36" class="cat-icon-img" loading="lazy">
                      {% elseif 'twitter' in _cn or ' x ' in _cn or _cn starts with 'x ' %}
                        <img src="https://storage.perfectcdn.com/aedutt/ltwt7j91tidgftuk.jpg" alt="{{ category['name'] }}" width="36" height="36" class="cat-icon-img" loading="lazy">
                      {% elseif 'youtube' in _cn %}
                        <img src="https://storage.perfectcdn.com/aedutt/0dscw3szefhkk9cz.jpg" alt="{{ category['name'] }}" width="36" height="36" class="cat-icon-img" loading="lazy">
                      {% elseif 'spotify' in _cn %}
                        <img src="https://storage.perfectcdn.com/aedutt/qhzn2oq7fmg5e6m5.jpg" alt="{{ category['name'] }}" width="36" height="36" class="cat-icon-img" loading="lazy">
                      {% elseif 'tiktok' in _cn %}
                        <img src="https://storage.perfectcdn.com/aedutt/slhouwdaax0d151d.jpg" alt="{{ category['name'] }}" width="36" height="36" class="cat-icon-img" loading="lazy">
                      {% elseif 'facebook' in _cn %}
                        <img src="https://storage.perfectcdn.com/aedutt/yzk2hlsmd61ao8ic.jpg" alt="{{ category['name'] }}" width="36" height="36" class="cat-icon-img" loading="lazy">
                      {% elseif 'discord' in _cn %}
                        <img src="https://storage.perfectcdn.com/aedutt/fp4pi4rl8yt5pant.jpg" alt="{{ category['name'] }}" width="36" height="36" class="cat-icon-img" loading="lazy">
                      {% elseif 'twitch' in _cn %}
                        <img src="https://storage.perfectcdn.com/aedutt/409i5yw8c1hn1gr1.jpg" alt="{{ category['name'] }}" width="36" height="36" class="cat-icon-img" loading="lazy">
                      {% elseif 'linkedin' in _cn %}
                        <img src="https://storage.perfectcdn.com/aedutt/fpwnytqmxlcgcz24.jpg" alt="{{ category['name'] }}" width="36" height="36" class="cat-icon-img" loading="lazy">
                      {% elseif 'pinterest' in _cn %}
                        <img src="https://storage.perfectcdn.com/aedutt/6nn4lxuqp0c6dg4x.jpg" alt="{{ category['name'] }}" width="36" height="36" class="cat-icon-img" loading="lazy">
                      {% elseif 'snapchat' in _cn %}
                        <img src="https://storage.perfectcdn.com/aedutt/iml3g73z5xz01sez.jpg" alt="{{ category['name'] }}" width="36" height="36" class="cat-icon-img" loading="lazy">
                      {% elseif 'google' in _cn %}
                        <img src="https://storage.perfectcdn.com/aedutt/3nhf4c1wjebrwsnc.jpg" alt="{{ category['name'] }}" width="36" height="36" class="cat-icon-img" loading="lazy">
                      {% elseif 'clubhouse' in _cn %}
                        <img src="https://storage.perfectcdn.com/aedutt/kzhpflyebnbpqdsw.jpg" alt="{{ category['name'] }}" width="36" height="36" class="cat-icon-img" loading="lazy">
                      {% elseif 'coinmarketcap' in _cn or 'cmc' in _cn %}
                        <img src="https://storage.perfectcdn.com/aedutt/myzi4wy2ff1qrfl8.jpg" alt="{{ category['name'] }}" width="36" height="36" class="cat-icon-img" loading="lazy">
                      {% elseif 'onlyfans' in _cn %}
                        <img src="https://storage.perfectcdn.com/aedutt/gs5hpf9gf3cab21a.jpg" alt="{{ category['name'] }}" width="36" height="36" class="cat-icon-img" loading="lazy">
                      {% elseif 'seo' in _cn or 'website' in _cn or 'traffic' in _cn %}
                        <img src="https://storage.perfectcdn.com/aedutt/59cm3enf3alwk4k3.jpg" alt="{{ category['name'] }}" width="36" height="36" class="cat-icon-img" loading="lazy">
                      {% elseif category['icon'] %}
                        {% set categoryIcon = category['icon'] %}
                        {% if categoryIcon['icon_type'] == 'icon' %}
                          <span class="cat-icon {{ categoryIcon['icon'] }}"></span>
                        {% elseif categoryIcon['icon_type'] == 'emoji' %}
                          <span class="cat-icon">{{ categoryIcon['icon'] }}</span>
                        {% elseif categoryIcon['icon_type'] == 'image' %}
                          <img src="{{ categoryIcon['url'] }}" alt="{{ category['name'] }}" class="cat-icon-img" loading="lazy">
                        {% endif %}
                      {% else %}
                        <img src="https://storage.perfectcdn.com/aedutt/tj3b7t8rz5ofk33c.jpg" alt="{{ category['name'] }}" width="36" height="36" class="cat-icon-img" loading="lazy">
                      {% endif %}
                      <strong>{{ category['name'] }}</strong>
                    </div>
                  </td>
                </tr>
              {% endif %}
              {% for service in category['services'] %}
                <tr data-filter-table-category-id="{{ category.id }}">
                  {% if user.favorite_services %}
                    <td class="col-fav">
                      <span role="button"
                            class="fav-toggle {% if service.favorite %}favorite-active{% endif %}"
                            data-favorite-service-id="{{ service.id }}"
                            aria-label="{{ lang('services.favorite') }}">
                        <span data-favorite-icon class="{% if service.favorite %}fas fa-star{% else %}far fa-star{% endif %}"></span>
                      </span>
                    </td>
                  {% endif %}
                  <td class="tabular ink col-id" data-filter-table-service-id="{{ service.id }}">{{ service['id'] }}</td>
                  <td class="service-name col-svc-name" data-filter-table-service-name="true">{{ service['name'] }}</td>
                  <td>{{ service['min'] }} - {{ service['max'] }}</td>
                  <td class="tabular nowrap col-rate">
                    {% if converted %}
                      <span data-toggle="tooltip" data-placement="top" title="{{ service.original_rate }}">{{ service.rate }}</span>
                    {% else %}
                      {{ service.rate }}
                    {% endif %}
                  </td>
                  {% if site['average_time'] %}
                    <td class="nowrap muted col-avg">{{ service['average_time'] }}</td>
                  {% endif %}
                  {% if serviceDescription %}
                    <td class="hidden-xs hidden-sm service-description col-desc"><span class="desc-text">{{ service['description'] }}</span></td>
                  {% endif %}
                  <td class="col-order">
                    {% if user.auth %}
                      <a href="{{ page_url('neworder') }}?service={{ service['id'] }}" class="btn-order-service lp-cta lp-cta--secondary" title="Order this service">
                        <span class="hidden-xs">Order</span>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                      </a>
                    {% else %}
                      <a href="{{ page_url('signup') }}?ref=svc-{{ service['id'] }}" class="btn-order-service lp-cta lp-cta--secondary" title="Sign up to order">
                        <span class="hidden-xs">Order</span>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                      </a>
                    {% endif %}
                  </td>
                </tr>
                {% if serviceDescription and service['description'] %}
                  <tr data-filter-table-category-id="{{ category.id }}" class="visible-xs visible-sm service-description-mobile">
                    <td colspan="100%">{{ service['description'] }}</td>
                  </tr>
                {% endif %}
              {% endfor %}
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
</div>

{% if servicesText %}
  <div class="services-text-wrap" style="display:none">
    <div class="services-text {% if site['rtl'] %}rtl-content{% endif %}">
      {{ servicesText }}
    </div>
  </div>
{% endif %}

<script>
(function(){
  // ── Platform map ──────────────────────────────────────────────────────────
  var PLATFORM_MAP = [
    { name: 'Telegram', keywords: ['telegram', 'tg '] },
    { name: 'Instagram', keywords: ['instagram'] },
    { name: 'Twitter', keywords: ['twitter'] },
    { name: 'TikTok', keywords: ['tiktok'] },
    { name: 'YouTube', keywords: ['youtube'] },
    { name: 'Facebook', keywords: ['facebook'] },
    { name: 'LinkedIn', keywords: ['linkedin'] },
    { name: 'Pinterest', keywords: ['pinterest'] },
    { name: 'Spotify', keywords: ['spotify'] },
    { name: 'Snapchat', keywords: ['snapchat'] },
    { name: 'Discord', keywords: ['discord'] },
    { name: 'Twitch', keywords: ['twitch'] },
    { name: 'Google', keywords: ['google'] },
    { name: 'Threads', keywords: ['threads', 'thread'] }
  ];

  var serviceTable = document.getElementById('service-table');
  if (!serviceTable) return;

  // ── Collect category metadata ─────────────────────────────────────────────
  var catRowEls = serviceTable.querySelectorAll('.services-cat-row');
  var catData = [];
  catRowEls.forEach(function(row) {
    var id = row.getAttribute('data-filter-table-category-id');
    var strong = row.querySelector('.services-cat-head strong');
    var name = strong ? strong.textContent.trim() : '';
    catData.push({ id: id, name: name, nameLower: name.toLowerCase() });
  });

  // Map categories → platforms
  var catToPlatform = {};
  var platformHasCategories = {};
  catData.forEach(function(c) {
    for (var i = 0; i < PLATFORM_MAP.length; i++) {
      var p = PLATFORM_MAP[i];
      if (p.keywords.some(function(k) { return c.nameLower.indexOf(k) !== -1; })) {
        catToPlatform[c.id] = p.name;
        platformHasCategories[p.name] = true;
        return;
      }
    }
    catToPlatform[c.id] = '__other__';
    platformHasCategories['__other__'] = true;
  });

  // Populate legacy dropdown platform items
  var activePlatforms = [];
  PLATFORM_MAP.forEach(function(p) { if (platformHasCategories[p.name]) activePlatforms.push(p.name); });
  if (platformHasCategories['__other__']) activePlatforms.push('__other__');

  var platformDivider = document.querySelector('.dropdown-platform-divider');
  var platformItemsSlot = document.getElementById('dropdown-platform-items');
  var catDivider = document.querySelector('.dropdown-cat-divider');
  if (platformItemsSlot && activePlatforms.length > 1) {
    platformDivider.style.display = '';
    catDivider.style.display = '';
    var frag = document.createDocumentFragment();
    activePlatforms.forEach(function(pName) {
      var li = document.createElement('li');
      var a = document.createElement('a');
      a.className = 'dropdown-item dropdown-item--platform';
      a.href = '#';
      a.setAttribute('data-filter-platform', pName);
      a.textContent = pName === '__other__' ? 'Other' : pName;
      li.appendChild(a);
      frag.appendChild(li);
    });
    platformItemsSlot.parentNode.insertBefore(frag, platformItemsSlot);
    platformItemsSlot.remove();
  }

  // ── Cache DOM refs ────────────────────────────────────────────────────────
  var allTabs = document.querySelectorAll('.svc-platform-tab[data-filter-platform]');
  var filterLabel = document.querySelector('.services-filter-label');
  var defaultSpan = filterLabel ? filterLabel.querySelector('.services-filter-default') : null;
  var activeSpan = filterLabel ? filterLabel.querySelector('[data-filter-active-category]') : null;

  // Group service rows by category ID
  var svcRowsByCat = {};
  var allServiceRows = [];
  catRowEls.forEach(function(catRow) {
    svcRowsByCat[catRow.getAttribute('data-filter-table-category-id')] = [];
  });
  var allRows = serviceTable.querySelectorAll('tbody > tr[data-filter-table-category-id]');
  allRows.forEach(function(row) {
    if (row.classList.contains('services-cat-row')) return;
    var catId = row.getAttribute('data-filter-table-category-id');
    if (!svcRowsByCat[catId]) svcRowsByCat[catId] = [];
    svcRowsByCat[catId].push(row);
    allServiceRows.push(row);
  });

  // ── State ─────────────────────────────────────────────────────────────────
  var currentPlatform = 'all';
  var isSearching = false;

  // ── Initial state: all service rows hidden, only category headers shown ───
  allServiceRows.forEach(function(row) { row.style.display = 'none'; });

  // Accordion helper — open/close a single category's service rows
  function setCatOpen(catRow, open) {
    var catId = catRow.getAttribute('data-filter-table-category-id');
    var rows = svcRowsByCat[catId] || [];
    catRow.classList.toggle('is-open', !!open);
    catRow.setAttribute('aria-expanded', open ? 'true' : 'false');
    for (var i = 0; i < rows.length; i++) {
      rows[i].style.display = open ? '' : 'none';
    }
  }

  // Make the category headers behave like accordion triggers
  catRowEls.forEach(function(catRow) {
    catRow.setAttribute('role', 'button');
    catRow.setAttribute('tabindex', '0');
    catRow.setAttribute('aria-expanded', 'false');
    catRow.addEventListener('click', function(e) {
      // Ignore clicks bubbling from internal links / order buttons
      if (e.target.closest('a, button, .fav-toggle')) return;
      setCatOpen(catRow, !catRow.classList.contains('is-open'));
    });
    catRow.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        setCatOpen(catRow, !catRow.classList.contains('is-open'));
      }
    });
  });

  // ── Platform filter — selects a platform and expands ALL its services ─────
  function applyPlatformFilter(platform) {
    if (platform === currentPlatform) return;
    currentPlatform = platform;

    // Update tab active states
    for (var t = 0; t < allTabs.length; t++) {
      var match = allTabs[t].getAttribute('data-filter-platform') === platform;
      allTabs[t].classList.toggle('svc-platform-tab--active', match);
      allTabs[t].setAttribute('aria-selected', match ? 'true' : 'false');
    }

    // "all" = show every category header, collapse every accordion
    // specific platform = show only that platform's categories + auto-expand them
    catRowEls.forEach(function(catRow) {
      var catId = catRow.getAttribute('data-filter-table-category-id');
      var plat = catToPlatform[catId] || '__other__';
      var platMatch = platform === 'all' || plat === platform;

      catRow.style.display = platMatch ? '' : 'none';
      setCatOpen(catRow, platMatch && platform !== 'all');
    });

    // Update filter label
    if (platform === 'all') {
      if (defaultSpan) defaultSpan.style.display = '';
      if (activeSpan) activeSpan.textContent = '';
    } else {
      if (defaultSpan) defaultSpan.style.display = 'none';
      if (activeSpan) activeSpan.textContent = platform === '__other__' ? 'Other' : platform;
    }

    // Clear search when switching platforms
    var si = document.querySelector('.svc-search__input');
    if (si && si.value) { si.value = ''; isSearching = false; }
  }

  // ── Search — filters services across all platforms, auto-expands matches ──
  function exitSearchMode() {
    isSearching = false;
    // Restore to current platform state
    catRowEls.forEach(function(catRow) {
      var catId = catRow.getAttribute('data-filter-table-category-id');
      var plat = catToPlatform[catId] || '__other__';
      var platMatch = currentPlatform === 'all' || plat === currentPlatform;

      catRow.style.display = platMatch ? '' : 'none';
      setCatOpen(catRow, platMatch && currentPlatform !== 'all');
    });
  }

  function applySearch(query) {
    if (!query) { exitSearchMode(); return; }
    isSearching = true;
    var q = query.toLowerCase();

    catRowEls.forEach(function(catRow) {
      var catId = catRow.getAttribute('data-filter-table-category-id');
      var plat = catToPlatform[catId] || '__other__';
      var platOk = currentPlatform === 'all' || plat === currentPlatform;
      var hasMatch = false;

      var rows = svcRowsByCat[catId] || [];
      for (var i = 0; i < rows.length; i++) {
        var row = rows[i];
        if (row.classList.contains('service-description-mobile')) {
          row.style.display = 'none'; continue;
        }
        if (!platOk) { row.style.display = 'none'; continue; }

        var nameEl = row.querySelector('[data-filter-table-service-name]');
        var idEl = row.querySelector('[data-filter-table-service-id]');
        var nameMatch = nameEl && nameEl.textContent.toLowerCase().indexOf(q) !== -1;
        var idMatch = idEl && idEl.textContent.indexOf(q) !== -1;

        if (nameMatch || idMatch) { row.style.display = ''; hasMatch = true; }
        else { row.style.display = 'none'; }
      }

      catRow.style.display = (platOk && hasMatch) ? '' : 'none';
      // Reflect open state visually — search auto-expands matching categories
      catRow.classList.toggle('is-open', !!(platOk && hasMatch));
      catRow.setAttribute('aria-expanded', (platOk && hasMatch) ? 'true' : 'false');
    });
  }

  var searchInput = document.querySelector('.svc-search__input');
  if (searchInput) {
    var searchTimer;
    searchInput.addEventListener('input', function() {
      clearTimeout(searchTimer);
      var val = searchInput.value.trim();
      searchTimer = setTimeout(function() { applySearch(val); }, 120);
    });
  }

  // ── More / Less panel ─────────────────────────────────────────────────────
  var morePanel = document.getElementById('svc-more-panel');
  var moreToggle = document.getElementById('svc-more-toggle');
  if (morePanel) {
    var moreTabs = morePanel.querySelectorAll('.svc-platform-tab[data-filter-platform]');
    var visibleMoreCount = 0;
    moreTabs.forEach(function(tab) {
      var p = tab.getAttribute('data-filter-platform');
      if (platformHasCategories[p]) { tab.style.display = ''; visibleMoreCount++; }
      else { tab.style.display = 'none'; }
    });
    if (visibleMoreCount === 0 && moreToggle) moreToggle.style.display = 'none';
  }
  var lessToggle = document.getElementById('svc-less-toggle');
  if (moreToggle && morePanel) {
    moreToggle.addEventListener('click', function(e) {
      e.preventDefault(); morePanel.classList.add('is-open'); moreToggle.style.display = 'none';
    });
  }
  if (lessToggle && morePanel) {
    lessToggle.addEventListener('click', function(e) {
      e.preventDefault(); morePanel.classList.remove('is-open'); moreToggle.style.display = '';
    });
  }

  // ── Tab click handlers ────────────────────────────────────────────────────
  document.addEventListener('click', function(e) {
    var tab = e.target.closest('.svc-platform-tab');
    if (!tab || tab.classList.contains('svc-toggle-btn')) return;
    e.preventDefault();
    applyPlatformFilter(tab.getAttribute('data-filter-platform'));
  });
  document.addEventListener('click', function(e) {
    var platformLink = e.target.closest('.dropdown-item--platform');
    if (!platformLink) return;
    e.preventDefault();
    applyPlatformFilter(platformLink.getAttribute('data-filter-platform'));
  });

  // ── Description expand (desktop col-desc / mobile full-row tap) ───────────
  function parseDescription(html) {
    var sections = html.replace(/\s+/g, ' ')
                       .split(/<br\s*\/?>\s*<br\s*\/?>/i)
                       .map(function(s){ return s.trim(); })
                       .filter(Boolean);
    if (sections.length === 0) return null;
    var title = sections[0].replace(/<br\s*\/?>/gi, ' ').trim();
    var bullets = sections.slice(1).map(function(sec){
      var lines = sec.split(/<br\s*\/?>/i).map(function(s){ return s.trim(); }).filter(Boolean);
      return { main: lines[0] || '', sub: lines.slice(1).join(' ') };
    });
    return { title: title, bullets: bullets };
  }

  function renderList(parsed) {
    var ul = document.createElement('ul');
    ul.className = 'desc-list';
    if (parsed.title) {
      var t = document.createElement('div');
      t.className = 'desc-title';
      t.innerHTML = parsed.title;
      ul.appendChild(t);
    }
    parsed.bullets.forEach(function(b){
      var li = document.createElement('li');
      var main = document.createElement('span');
      main.className = 'desc-line-main';
      main.innerHTML = b.main;
      li.appendChild(main);
      if (b.sub) {
        var sub = document.createElement('span');
        sub.className = 'desc-line-sub';
        sub.innerHTML = b.sub;
        li.appendChild(sub);
      }
      ul.appendChild(li);
    });
    return ul;
  }

  document.addEventListener('click', function(e){
    if (e.target.closest('.fav-toggle')) return;
    var tr = e.target.closest('.services-table tbody > tr');
    if (!tr || tr.classList.contains('services-cat-row') || tr.classList.contains('service-description-mobile')) return;

    var row = null;
    var cell = null;

    if (window.innerWidth > 991) {
      cell = e.target.closest('.services-table .col-desc');
      if (!cell) return;
      row = cell.closest('tr');
    } else {
      row = tr;
    }
    if (!row) return;

    if (cell && !cell.dataset.parsed) {
      var span = cell.querySelector('.desc-text');
      if (span) {
        var parsed = parseDescription(span.innerHTML);
        if (parsed && parsed.bullets.length) {
          cell.appendChild(renderList(parsed));
        }
      }
      cell.dataset.parsed = '1';
    }
    row.classList.toggle('is-desc-open');
  });
})();
</script>
