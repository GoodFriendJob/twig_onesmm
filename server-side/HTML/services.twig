{# services.twig — Pulse theme
   Drop-in replacement: same variable contract as the default.
   Variables used:
     site.rtl, site.average_time, site.currencies, site.currency.label
     user.auth, user.favorite_services, user.currency.label
     serviceCategoryList[]   (each: id, name, icon{icon_type,icon,url}, services[])
     services in category    (each: id, name, rate, original_rate, min, max,
                               average_time, description, favorite)
     converted               (bool — show original_rate tooltip)
     serviceDescription      (bool — show description column)
     servicesText            (admin-managed marketing copy)
     lang('services.*'), lang('general.search.placeholder')

   Behaviour hooks preserved (Perfect Panel core JS targets these):
     [data-filter-active-category]
     [data-filter-category-id], [data-filter-category-name]
     [data-filter-table-category-id], [data-filter-table-service-id]
     [data-filter-table-service-name]
     [data-search-service="#service-table"], [data-filter-serch-btn]
     [data-favorite-service-id], [data-favorite-icon]
     #service-table, #currencies-list, #currencies-item
#}
<div class="services-page">
    {# ─── Page header (matches design: "Services List") ─── #}
    <div class="subpage-head">
      <h1 class="subpage-title"><span>Services</span> List</h1>
    </div>

    {# ─── Filter section ─── #}
    <div class="svc-filter-section {% if site['rtl'] %}rtl-nav{% endif %}">

      <div class="svc-filter-label">Choose a <strong>Platform</strong></div>

      {# Visual platform tabs — single grid wrapper so the main row and the
         "more" extras flow as ONE continuous, reflowing grid. #}
      <div class="svc-tabs-grid">

        <div class="svc-platform-tabs" role="tablist">

          <button class="svc-platform-tab svc-platform-tab--active" role="tab" data-filter-platform="all" aria-selected="true">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 8.27V4.23C22 2.64 21.36 2 19.77 2H15.73C14.14 2 13.5 2.64 13.5 4.23V8.27C13.5 9.86 14.14 10.5 15.73 10.5H19.77C21.36 10.5 22 9.86 22 8.27Z" stroke-linecap="round" stroke-linejoin="round"/><path d="M10.5 8.52V3.98C10.5 2.57 9.86 2 8.27 2H4.23C2.64 2 2 2.57 2 3.98V8.51C2 9.93 2.64 10.49 4.23 10.49H8.27C9.86 10.5 10.5 9.93 10.5 8.52Z" stroke-linecap="round" stroke-linejoin="round"/><path d="M10.5 19.77V15.73C10.5 14.14 9.86 13.5 8.27 13.5H4.23C2.64 13.5 2 14.14 2 15.73V19.77C2 21.36 2.64 22 4.23 22H8.27C9.86 22 10.5 21.36 10.5 19.77Z" stroke-linecap="round" stroke-linejoin="round"/><path opacity="0.4" d="M15 15.5H21" stroke-linecap="round"/><path opacity="0.4" d="M15 19.5H21" stroke-linecap="round"/></svg>
            <span>All</span>
          </button>

          <button class="svc-platform-tab" role="tab" data-filter-platform="Telegram" aria-selected="false">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M21.95 4.27 18.7 19.6c-.24 1.08-.88 1.35-1.78.84l-4.92-3.63-2.37 2.28c-.26.26-.48.48-.99.48l.36-5.05 9.18-8.3c.4-.36-.09-.55-.62-.2L6.21 13.16 1.32 11.62c-1.06-.33-1.08-1.06.22-1.57l19.12-7.37c.88-.33 1.65.2 1.29 1.59z"/></svg>
            <span>Telegram</span>
          </button>

          <button class="svc-platform-tab" role="tab" data-filter-platform="Instagram" aria-selected="false">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg>
            <span>Instagram</span>
          </button>

          <button class="svc-platform-tab" role="tab" data-filter-platform="TikTok" aria-selected="false">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.3 0 .59.04.88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5.8 20.1a6.34 6.34 0 0 0 10.86-4.43V8.93a8.16 8.16 0 0 0 4.77 1.52V7a4.85 4.85 0 0 1-1.84-.31z"/></svg>
            <span>TikTok</span>
          </button>

          <button class="svc-platform-tab" role="tab" data-filter-platform="Twitter" aria-selected="false">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            <span>X / Twitter</span>
          </button>

          <button class="svc-platform-tab" role="tab" data-filter-platform="YouTube" aria-selected="false">
