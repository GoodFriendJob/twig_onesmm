{# subscriptions.twig — styled to match the Orders page
   Variables: site.rtl, page.url, status, search, orderList[], pagination, lang(...)
#}
<div class="subpage subscriptions-page">

  <div class="subpage-head">
    <h1 class="subpage-title"><span>Subscriptions</span> Status</h1>
  </div>

  <div class="subpage-card subpage-card--flush ord-card">

    {# ─── Search ─── #}
    <div class="ord-toolbar">
      <form action="{{ page['url'] }}" method="get" id="history-search" class="ord-search">
        <svg class="ord-search-ic" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <input type="text" name="search" value="{{ search }}" placeholder="{{ lang('general.search.placeholder') }}">
      </form>

      {# ─── Status filter chips ─── #}
      {% set tabs = [
        { key: 'all',       url: page['url'],                 label: lang('subscriptions.status.all') },
        { key: 'active',    url: page['url'] ~ '/active',     label: lang('subscriptions.status.active') },
        { key: 'paused',    url: page['url'] ~ '/paused',     label: lang('subscriptions.status.paused') },
        { key: 'completed', url: page['url'] ~ '/completed',  label: lang('subscriptions.status.completed') },
        { key: 'expired',   url: page['url'] ~ '/expired',    label: lang('subscriptions.status.expired') },
        { key: 'canceled',  url: page['url'] ~ '/canceled',   label: lang('subscriptions.status.canceled') }
      ] %}
      <div class="ord-filters {% if site['rtl'] %}rtl-nav{% endif %}">
        {% for tab in tabs %}
          <a href="{{ tab.url }}" class="ord-filter{% if tab.key == status %} is-active{% endif %}">{{ tab.label }}</a>
        {% endfor %}
      </div>
    </div>

    {# ─── Subscriptions table ─── #}
    <div class="ord-table-wrap">
      <table class="ord-table {% if site['rtl'] %}rtl-table{% endif %}">
        <thead>
          <tr>
            <th>{{ lang('subscriptions.id') }}</th>
            <th>{{ lang('subscriptions.username') }}</th>
            <th class="nowrap num">{{ lang('subscriptions.quantity') }}</th>
            <th class="nowrap num">{{ lang('subscriptions.new_posts') }}</th>
            <th class="nowrap num">{{ lang('subscriptions.old_posts') }}</th>
            <th class="nowrap num">{{ lang('subscriptions.delay') }}</th>
            <th>{{ lang('subscriptions.service') }}</th>
            <th>{{ lang('subscriptions.status') }}</th>
            <th class="nowrap">{{ lang('subscriptions.created') }}</th>
            <th class="nowrap">{{ lang('subscriptions.expiry') }}</th>
            <th class="ord-col-act"></th>
          </tr>
        </thead>
        <tbody>
          {% for order in orderList %}
            {% set s = order['status']|lower %}
            {% set st =
              s matches '/active/'    ? 'green' :
              s matches '/complete/'  ? 'blue' :
              s matches '/expir/'     ? 'amber' :
              s matches '/paus/'      ? 'gray' :
              s matches '/cancel/'    ? 'red' : 'gray' %}
            {% set act =
              s matches '/paus/'   ? 'resume' :
              s matches '/active/' ? 'cancel' : 'reorder' %}
            <tr>
              <td class="ord-id tabular" data-label="{{ lang('subscriptions.id') }}">{{ order['id'] }}</td>
              <td class="ord-username" data-label="{{ lang('subscriptions.username') }}"><span class="ord-link" title="{{ order['username'] }}">{{ order['username'] }}</span></td>
              <td class="tabular nowrap num" data-label="{{ lang('subscriptions.quantity') }}">{% if order['quantity_min'] == order['quantity_max'] %}{{ order['quantity_max'] }}{% else %}{{ order['quantity_min'] }}–{{ order['quantity_max'] }}{% endif %}</td>
              <td class="tabular nowrap num" data-label="{{ lang('subscriptions.new_posts') }}">{{ order['posts'] }}</td>
              <td class="tabular nowrap num" data-label="{{ lang('subscriptions.old_posts') }}">{{ order['old_posts'] }}</td>
              <td class="tabular nowrap num" data-label="{{ lang('subscriptions.delay') }}">{{ order['delay'] }}</td>
              <td class="ord-service" title="{{ order['service'] }}" data-label="{{ lang('subscriptions.service') }}">
                {% if order['service_id'] %}<span class="ord-service-id">{{ order['service_id'] }}</span><span class="ord-service-sep">|</span>{% endif %}
                <span class="ord-service-name">{{ order['service'] }}</span>
              </td>
              <td data-label="{{ lang('subscriptions.status') }}"><span class="ord-status ord-status--{{ st }}">{{ order['status'] }}</span></td>
              <td class="ord-date nowrap" data-label="{{ lang('subscriptions.created') }}"><span class="ord-date-d tabular">{{ order['date'] }}</span></td>
              <td class="ord-date nowrap" data-label="{{ lang('subscriptions.expiry') }}"><span class="ord-date-d tabular">{{ order['expiry'] }}</span></td>
              <td class="ord-col-act" data-label="">
                {% if act == 'resume' %}
                  <a href="{{ page['url'] }}/resume/{{ order['id'] }}" class="ord-act ord-act--grad">{{ lang('subscriptions.button.unpause')|default('Resume') }}
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M8 5v14l11-7z"/></svg>
                  </a>
                {% elseif act == 'reorder' %}
                  <a href="{{ page['url'] }}/reorder/{{ order['id'] }}" class="ord-act ord-act--grad">{{ lang('subscriptions.button.reorder')|default('Reorder') }}
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 4v6h-6"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                  </a>
                {% else %}
                  <a href="{{ page['url'] }}/stop/{{ order['id'] }}" class="ord-act ord-act--ghost">{{ lang('subscriptions.button.cancel')|default('Cancel') }}</a>
                {% endif %}
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="11"><div class="ord-empty">{{ lang('subscriptions.empty')|default('No subscriptions to show.') }}</div></td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  {% if pagination['count'] > 100 %}
    <ul class="pagination orders-pagination {% if site['rtl'] %}rtl-pagination{% endif %}">
      {% if pagination['current'] != 1 %}
        <li><a href="{{ page['url'] }}/{{ status }}/{{ pagination['last'] }}{% if search %}?search={{ search }}{% endif %}" aria-label="Previous">&laquo;</a></li>
      {% endif %}
      {% set r, l = 3, 3 %}
      {% if pagination['current'] == 1 %}{% set r = 6 %}{% endif %}
      {% if pagination['current'] == 2 %}{% set r = 5 %}{% endif %}
      {% if pagination['current'] >= pagination['pages'] %}{% set l = 5 %}{% endif %}
      {% for i in 1..ceil(pagination['pages']) %}
        {% if i >= (pagination['current']-l) and i <= (pagination['current']+r) %}
          <li{% if i == pagination['current'] %} class="active"{% endif %}><a href="{{ page['url'] }}/{{ status }}/{{ i }}{% if search %}?search={{ search }}{% endif %}">{{ i }}</a></li>
        {% endif %}
      {% endfor %}
      {% if pagination['current'] < pagination['pages'] %}
        <li><a href="{{ page['url'] }}/{{ status }}/{{ pagination['next'] }}{% if search %}?search={{ search }}{% endif %}" aria-label="Next">&raquo;</a></li>
      {% endif %}
    </ul>
  {% endif %}

</div>
