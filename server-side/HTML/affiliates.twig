{# affiliates.twig — "Affiliate and Grow" (matches new design)
   Variables: site.rtl, page.url, statistics{total_earnings, available_earnings,
              visits, registrations, referrals, conversion_rate},
              referral_link, commission_rate, minimum_payout,
              affiliates[{avatar, username, date, time, spent, commission}],
              payments[{date, time, amount, remained}], pagination, lang(...)
#}
<div class="subpage affiliates-page">

  <div class="subpage-head">
    <h1 class="subpage-title"><span>Affiliate</span> and Grow</h1>
  </div>

  <div class="subpage-body">

    {# ── KPI row ── #}
    <div class="aff-kpis">
      <div class="aff-kpi aff-kpi--accent">
        <div class="aff-kpi-label">{{ lang('affiliates.total_earnings') }}</div>
        <div class="aff-kpi-value tabular">{{ statistics['total_earnings'] }}</div>
        <svg class="aff-wm-one" viewBox="0 0 125 192" fill="#fff" preserveAspectRatio="xMidYMid meet" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M75.5494 0H125L63.1868 62.1583H83.7912C85.2484 62.1583 86.646 62.7404 87.6764 63.7766C88.7068 64.8127 89.2857 66.2181 89.2857 67.6835V186.475C89.2857 187.94 88.7068 189.346 87.6764 190.382C86.646 191.418 85.2484 192 83.7912 192H45.3297C43.8724 192 42.4749 191.418 41.4445 190.382C40.414 189.346 39.8352 187.94 39.8352 186.475V75.9712H0L75.5494 0Z"/></svg>
      </div>
      <div class="aff-kpi">
        <div class="aff-kpi-label">{{ lang('affiliates.available_earnings') }}</div>
        <div class="aff-kpi-value aff-kpi-value--green tabular">{{ statistics['available_earnings'] }}</div>
      </div>
      <div class="aff-kpi">
        <div class="aff-kpi-label">{{ lang('affiliates.visits') }}</div>
        <div class="aff-kpi-value tabular">{{ statistics['visits'] }}</div>
        <svg class="aff-kpi-wm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
      </div>
      <div class="aff-kpi">
        <div class="aff-kpi-label">{{ lang('affiliates.registrations') }}</div>
        <div class="aff-kpi-value tabular">{{ statistics['registrations'] }}</div>
        <svg class="aff-kpi-wm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="m16 11 2 2 4-4"/></svg>
      </div>
      <div class="aff-kpi">
        <div class="aff-kpi-label">{{ lang('affiliates.referrals') }}</div>
        <div class="aff-kpi-value tabular">{{ statistics['referrals'] }}</div>
        <svg class="aff-kpi-wm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </div>
      <div class="aff-kpi">
        <div class="aff-kpi-label">{{ lang('affiliates.conversion_rate') }}</div>
        <div class="aff-kpi-value tabular">{{ statistics['conversion_rate'] }}</div>
        <svg class="aff-kpi-wm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
      </div>
    </div>

    {# ── Referral link (gradient) + program terms ── #}
    <div class="aff-row2">
      <div class="aff-reflink">
        <svg class="aff-wm-one aff-wm-one--reflink" viewBox="0 0 125 192" fill="#fff" preserveAspectRatio="xMidYMid meet" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M75.5494 0H125L63.1868 62.1583H83.7912C85.2484 62.1583 86.646 62.7404 87.6764 63.7766C88.7068 64.8127 89.2857 66.2181 89.2857 67.6835V186.475C89.2857 187.94 88.7068 189.346 87.6764 190.382C86.646 191.418 85.2484 192 83.7912 192H45.3297C43.8724 192 42.4749 191.418 41.4445 190.382C40.414 189.346 39.8352 187.94 39.8352 186.475V75.9712H0L75.5494 0Z"/></svg>
        <div class="aff-reflink-title">{{ lang('affiliates.referral_link') }}</div>
        <p class="aff-reflink-sub">Share this link anywhere — Telegram, Discord, your site, your bio. Every signup is tagged to you forever.</p>
        <div class="aff-reflink-row">
          <input type="text" id="aff-referral-input" class="aff-reflink-input" value="{{ referral_link }}" readonly>
          <button type="button" class="aff-copy-btn" title="Copy link" onclick="
            var el = document.getElementById('aff-referral-input');
            el.select(); el.setSelectionRange(0, 99999);
            try { document.execCommand('copy'); } catch(e) {}
            if (navigator.clipboard) navigator.clipboard.writeText(el.value);
            this.classList.add('is-copied');
            var b = this; setTimeout(function(){ b.classList.remove('is-copied'); }, 1400);
          ">
            <svg class="aff-copy-ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <svg class="aff-copy-ok" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          </button>
        </div>
      </div>

      <div class="aff-terms">
        <div class="aff-term">
          <div class="aff-term-label">{{ lang('affiliates.commission_rate') }}</div>
          <div class="aff-term-value tabular">{{ commission_rate }}</div>
        </div>
        <div class="aff-term">
          <div class="aff-term-label">{{ lang('affiliates.minimum_payout') }}</div>
          <div class="aff-term-value tabular">{{ minimum_payout }}</div>
        </div>
      </div>
    </div>

    {# ── Referred users ── #}
    <div class="subpage-card subpage-card--flush">
      <div class="aff-card-head"><h2 class="box-title">Referred <b>Users</b></h2></div>
      <div class="aff-table-wrap">
        <table class="aff-table {% if site['rtl'] %}rtl-table{% endif %}">
          <thead>
            <tr>
              <th>{{ lang('affiliates.user') }}</th>
              <th>{{ lang('affiliates.join_date') }}</th>
              <th>{{ lang('affiliates.spent') }}</th>
              <th>{{ lang('affiliates.your_commission') }}</th>
            </tr>
          </thead>
          <tbody>
            {% for a in affiliates %}
              <tr>
                <td>
                  <div class="aff-user">
                    {% if a['avatar'] %}
                      <img class="aff-avatar" src="{{ a['avatar'] }}" alt="">
                    {% else %}
                      <span class="aff-avatar aff-avatar--letter">{{ a['username']|first|upper }}</span>
                    {% endif %}
                    <span class="aff-user-name">{{ a['username'] }}</span>
                  </div>
                </td>
                <td class="aff-date tabular">{{ a['date'] }}{% if a['time'] %} <span class="aff-date-sep">|</span> {{ a['time'] }}{% endif %}</td>
                <td class="aff-spent tabular">{{ a['spent'] }}</td>
                <td class="aff-comm tabular">{{ a['commission'] }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>

    {# ── Payment history ── #}
    {% if payments|length %}
      <div class="subpage-card subpage-card--flush">
        <div class="aff-card-head"><h2 class="box-title">Payment <b>History</b></h2></div>
        <div class="aff-table-wrap">
          <table class="aff-table {% if site['rtl'] %}rtl-table{% endif %}">
            <thead>
              <tr>
                <th>{{ lang('affiliates.payout_date') }}</th>
                <th>{{ lang('affiliates.payout_amount') }}</th>
                <th>{{ lang('affiliates.remained') }}</th>
              </tr>
            </thead>
            <tbody>
              {% for p in payments %}
                <tr>
                  <td class="aff-date tabular">{{ p['date'] }}{% if p['time'] %} <span class="aff-date-sep">|</span> {{ p['time'] }}{% endif %}</td>
                  <td class="aff-comm tabular">{{ p['amount'] }}</td>
                  <td class="aff-spent tabular">{{ p['remained'] }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    {% endif %}

  </div>
</div>
