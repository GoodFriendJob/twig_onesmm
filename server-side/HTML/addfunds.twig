{# addfunds.twig — "Add Funds" (matches new design)
   Variables: paymentsList[{id,name,category,icon,instruction}], currentPayment,
              site.cpf_field, site.rtl, addfunds (HTML), addfunds_aside (HTML),
              paymentList[{date,time,amount,method,affiliation}], pagination,
              success/successText, error/errorText, csrftoken, page, lang(...)
   PP also sets: window.modules.paymentMethods.fieldOptions[id].instruction.value
#}
<div class="subpage addfunds-page">

  <div class="subpage-head">
    <h1 class="subpage-title"><span>Add</span> Funds</h1>
  </div>

  <div class="addfunds-layout">

    {# ─── LEFT: payment form ─── #}
    <div class="addfunds-main subpage-card">
      <form method="post" action="" id="addfunds-form" {% if site['rtl'] %}class="rtl-form"{% endif %}>
        <input type="hidden" name="_csrf" value="{{ csrftoken }}">

        <div class="box-head">
          <h2 class="box-title">Choose a <b>Payment Method</b></h2>
          <p class="box-sub">Pick how you'd like to top up. Most methods credit your balance automatically within seconds of confirmation.</p>
        </div>

        {% if success %}
          <div class="alert alert-success alert-dismissible {% if site['rtl'] %}rtl-alert{% endif %}">
            <button type="button" class="close" data-dismiss="alert">&times;</button>
            {{ successText }}
          </div>
        {% endif %}
        {% if error %}
          <div class="alert alert-danger alert-dismissible {% if site['rtl'] %}rtl-alert{% endif %}">
            <button type="button" class="close" data-dismiss="alert">&times;</button>
            {{ errorText }}
          </div>
        {% endif %}

        {# Category filters #}
        <div class="pay-filters" role="tablist">
          <button type="button" class="pay-filter is-active" data-cat="all">All</button>
          <button type="button" class="pay-filter" data-cat="crypto">Crypto Currency</button>
          <button type="button" class="pay-filter" data-cat="card">Credit Card</button>
          <button type="button" class="pay-filter" data-cat="bank">Bank Transfer</button>
          <button type="button" class="pay-filter" data-cat="other">Other Methods</button>
        </div>

        {# Payment method tiles #}
        <div class="pay-tiles" id="pay-tiles">
          {% for payment in paymentsList %}
            {% set isSel = currentPayment == payment['id'] or (currentPayment is empty and loop.first) %}
            <label class="pay-tile{% if isSel %} is-active{% endif %}"
                   data-cat="{{ payment['category']|default('other') }}"
                   data-payment-id="{{ payment['id'] }}"
                   data-name="{{ payment['name'] }}"
                   data-icon="{{ payment['icon']|default('') }}"
                   data-instruction="{{ payment['instruction']|default('') }}">
              <input type="radio" class="pay-tile-radio" name="AddFoundsForm[type]" value="{{ payment['id'] }}"{% if isSel %} checked{% endif %}>
              <span class="pay-tile-ic">
                {# Real Perfect Panel payment logo (icon_key doesn't exist server-side).
                   Falls back to the first letter of the name if no icon / image fails to load. #}
                {% if payment['icon'] %}
                  <img src="{{ payment['icon'] }}" alt="{{ payment['name'] }}" class="pay-tile-img" loading="lazy"
                       onerror="this.style.display='none';if(this.nextElementSibling){this.nextElementSibling.style.display='';}">
                  <span class="pay-ic-letter" style="display:none">{{ payment['name']|first|upper }}</span>
                {% else %}
                  <span class="pay-ic-letter">{{ payment['name']|first|upper }}</span>
                {% endif %}
              </span>
              <span class="pay-tile-name">{{ payment['name'] }}</span>
            </label>
          {% endfor %}
        </div>

        {# Selected method + instruction #}
        <div class="pay-selected">
          <div class="pay-selected-head">
            <span class="pay-selected-ic" id="pay-sel-ic"></span>
            <span class="pay-selected-name" id="pay-sel-name"></span>
          </div>
          <h3 class="pay-instr-title">Instruction</h3>
          <div class="pay-instr-body" id="pay-instr-body">
            {% if addfunds %}{{ addfunds }}{% endif %}
          </div>
        </div>

        {# Amount #}
        <div class="pay-amount">
          <label for="amount" class="pay-amount-label">{{ lang('addfunds.amount') }}</label>
          <input type="text" inputmode="decimal" class="pay-amount-input tabular" name="AddFoundsForm[amount]" id="amount" placeholder="$15" autocomplete="off">
          <small class="pay-amount-hint">$1 minimum</small>
          <div class="amount-error" id="amount-error" role="alert"></div>
        </div>

        {% if site['cpf_field'] %}
          <div class="pay-amount">
            <label for="cpf" class="pay-amount-label">{{ lang('addfunds.cpf') }}</label>
            <input type="text" class="pay-amount-input" name="AddFoundsForm[cpf]" id="cpf">
          </div>
        {% endif %}

        <button type="submit" class="btn btn-primary lp-cta--gradient pay-submit" id="addfunds-submit">
          <span class="pay-label">{{ lang('addfunds.button.pay') }}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
          </span>
          <span class="pay-loading" style="display:none"><span class="btn-spinner"></span> Processing&hellip;</span>
        </button>
      </form>
    </div>

    {# ─── RIGHT: trust signals + history ─── #}
    <aside class="addfunds-side">
      {% if addfunds_aside %}
        <div class="subpage-card">
          <h2 class="box-title">Good to <b>know</b></h2>
          <div class="box-sub">{{ addfunds_aside }}</div>
        </div>
      {% else %}
        <div class="subpage-card addfunds-trust">
          <h2 class="box-title">Why deposit <b>with OneSMM</b></h2>
          <ul class="trust-list">
            <li class="trust-item">
              <span class="trust-ic" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              </span>
              <div class="trust-text">
                <div class="trust-title">Instant credit</div>
                <div class="trust-desc">Most methods top up your balance within seconds of confirmation.</div>
              </div>
            </li>
            <li class="trust-item">
              <span class="trust-ic" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              </span>
              <div class="trust-text">
                <div class="trust-title">Verified gateways</div>
                <div class="trust-desc">Every processor is vetted. Transactions are encrypted end-to-end.</div>
              </div>
            </li>
            <li class="trust-item">
              <span class="trust-ic" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              </span>
              <div class="trust-text">
                <div class="trust-title">24/7 support</div>
                <div class="trust-desc">Stuck on a deposit? Open a ticket and we'll fix it fast.</div>
              </div>
            </li>
          </ul>
        </div>
      {% endif %}

      {% if paymentList %}
        <div class="subpage-card subpage-card--flush addfunds-history">
          <div class="aff-card-head"><h2 class="box-title">Payment <b>History</b></h2></div>
          <div class="aff-table-wrap">
            <table class="aff-table addfunds-history-table {% if site['rtl'] %}rtl-table{% endif %}">
              <thead>
                <tr>
                  <th class="col-date">{{ lang('addfunds.date') }}</th>
                  <th class="col-amount">{{ lang('addfunds.amount') }}</th>
                  <th class="col-method">{{ lang('addfunds.method') }}</th>
                </tr>
              </thead>
              <tbody>
                {% for payment in paymentList %}
                  <tr>
                    <td class="aff-date tabular">
                      <span class="hist-date">{{ payment['date'] }}</span>
                      {% if payment['time'] %}<span class="hist-time">{{ payment['time'] }}</span>{% endif %}
                    </td>
                    <td class="aff-comm tabular hist-amount">{{ payment['amount'] }}</td>
                    <td class="hist-method{% if payment['affiliation'] %} hist-affil{% endif %}" title="{{ payment['method'] }}">{{ payment['method'] }}</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>

        {% if pagination['count'] > 50 %}
          <ul class="pagination {% if site['rtl'] %}rtl-pagination{% endif %}">
            {% if pagination['current'] != 1 %}
              <li><a href="{{ page['url'] }}/{{ pagination['last'] }}" aria-label="Previous">&laquo;</a></li>
            {% endif %}
            {% set r, l = 3, 3 %}
            {% if pagination['current'] == 1 %}{% set r = 6 %}{% endif %}
            {% if pagination['current'] == 2 %}{% set r = 5 %}{% endif %}
            {% if pagination['current'] >= pagination['pages'] %}{% set l = 5 %}{% endif %}
            {% for i in 1..ceil(pagination['pages']) %}
              {% if i >= (pagination['current']-l) and i <= (pagination['current']+r) %}
                <li{% if i == pagination['current'] %} class="active"{% endif %}><a href="{{ page['url'] }}/{{i}}">{{i}}</a></li>
              {% endif %}
            {% endfor %}
            {% if pagination['current'] < pagination['pages'] %}
              <li><a href="{{ page['url'] }}/{{ pagination['next'] }}" aria-label="Next">&raquo;</a></li>
            {% endif %}
          </ul>
        {% endif %}
      {% endif %}
    </aside>

  </div>
</div>

<script>
(function() {
  var tiles = Array.prototype.slice.call(document.querySelectorAll('.pay-tile'));
  var filters = Array.prototype.slice.call(document.querySelectorAll('.pay-filter'));
  var selIc = document.getElementById('pay-sel-ic');
  var selName = document.getElementById('pay-sel-name');
  var instrBody = document.getElementById('pay-instr-body');
  var defaultInstr = instrBody ? instrBody.innerHTML : '';

  // PP instruction lookup (live panels); falls back to tile's data-instruction
  function getInstruction(tile) {
    var pid = tile.getAttribute('data-payment-id');
    try {
      var fo = window.modules.paymentMethods.fieldOptions;
      if (fo[pid] && fo[pid].instruction && fo[pid].instruction.value) return fo[pid].instruction.value;
    } catch (e) {}
    var di = tile.getAttribute('data-instruction');
    return di || defaultInstr;
  }

  function selectTile(tile) {
    tiles.forEach(function(t){ t.classList.remove('is-active'); });
    tile.classList.add('is-active');
    var radio = tile.querySelector('.pay-tile-radio');
    if (radio) radio.checked = true;
    var tileIc = tile.querySelector('.pay-tile-ic');
    if (selIc && tileIc) selIc.innerHTML = tileIc.innerHTML;
    if (selName) selName.textContent = tile.getAttribute('data-name') || '';
    if (instrBody) instrBody.innerHTML = getInstruction(tile);
  }

  tiles.forEach(function(tile){
    tile.addEventListener('click', function(){ selectTile(tile); });
  });

  // Category filters
  filters.forEach(function(f){
    f.addEventListener('click', function(){
      filters.forEach(function(x){ x.classList.remove('is-active'); });
      f.classList.add('is-active');
      var cat = f.getAttribute('data-cat');
      tiles.forEach(function(t){
        t.style.display = (cat === 'all' || t.getAttribute('data-cat') === cat) ? '' : 'none';
      });
    });
  });

  // Initialise selected tile
  var active = document.querySelector('.pay-tile.is-active') || tiles[0];
  if (active) selectTile(active);

  // Amount validation + submit loading
  var amt = document.getElementById('amount');
  var amtErr = document.getElementById('amount-error');
  function sanitize(v){ return v.replace(/[^0-9.]/g,'').replace(/(\..*)\./g,'$1'); }
  if (amt) amt.addEventListener('input', function(){ amt.value = sanitize(amt.value); if (amtErr) amtErr.textContent=''; });
  var form = document.getElementById('addfunds-form');
  var btn = document.getElementById('addfunds-submit');
  if (form && btn) form.addEventListener('submit', function(e){
    var v = parseFloat(amt && amt.value);
    if (isNaN(v) || v < 1) { e.preventDefault(); if (amtErr) amtErr.textContent='Minimum deposit is $1.00'; if (amt) amt.focus(); return; }
    btn.disabled = true; btn.classList.add('loading');
    var l = btn.querySelector('.pay-label'), p = btn.querySelector('.pay-loading');
    if (l) l.style.display='none'; if (p) p.style.display='';
  });
})();
</script>
