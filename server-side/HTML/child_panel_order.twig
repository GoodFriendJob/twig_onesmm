{# child_panel_order.twig — Child panel order page (matches new design — mirrors child_panel.twig)
   Variables: site.rtl, page.url, childpanel, showForm, errorForm/errorFormMessage,
              form{domain,currency,username}, name_servers, currenciesList, price, csrftoken, lang(...)
#}
<div class="subpage childpanel-page">

  <div class="subpage-head">
    <h1 class="subpage-title"><span>Child</span> Panel / Reseller</h1>
  </div>

  {% if childpanel %}
    <article class="subpage-card faq-content childpanel-intro {% if site['rtl'] %}rtl-content{% endif %}">
      {{ childpanel }}
    </article>
  {% endif %}

  {% if showForm %}
  <div class="cp-layout">

    {# ─── LEFT: order form ─── #}
    <form action="{{ page['url'] }}" method="post" class="cp-main">
      {% if errorForm %}
        <div class="alert alert-dismissible alert-danger {% if site['rtl'] %}rtl-alert{% endif %}">
          <button type="button" class="close" data-dismiss="alert">&times;</button>
          {{ errorFormMessage }}
        </div>
      {% endif %}

      {# Order details #}
      <div class="subpage-card">
        <div class="box-head"><h2 class="box-title">Order <b>Details</b></h2></div>

        <div class="cp-field">
          <label for="domain" class="cp-label">{{ lang('child_panel.form.domain') }}</label>
          <input type="text" class="cp-input" id="domain" name="CreateOrderForm[domain]" value="{{ form['domain'] }}" placeholder="panel.example.com">
        </div>

        {# Gradient name-servers card #}
        <div class="cp-ns">
          <svg class="aff-wm-one aff-wm-one--reflink" viewBox="0 0 125 192" fill="#fff" preserveAspectRatio="xMidYMid meet" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M75.5494 0H125L63.1868 62.1583H83.7912C85.2484 62.1583 86.646 62.7404 87.6764 63.7766C88.7068 64.8127 89.2857 66.2181 89.2857 67.6835V186.475C89.2857 187.94 88.7068 189.346 87.6764 190.382C86.646 191.418 85.2484 192 83.7912 192H45.3297C43.8724 192 42.4749 191.418 41.4445 190.382C40.414 189.346 39.8352 187.94 39.8352 186.475V75.9712H0L75.5494 0Z"/></svg>
          <div class="cp-ns-title">{{ lang('child_panel.form.ns.info') }}</div>
          <div class="cp-ns-grid">
            {% for ns in name_servers %}
              <div class="cp-ns-col">
                <div class="cp-ns-label">DNS {{ loop.index }}</div>
                <div class="cp-ns-row">
                  <input type="text" class="cp-ns-input" value="{{ ns }}" readonly>
                  <button type="button" class="cp-ns-copy" title="Copy" onclick="
                    var v = this.previousElementSibling.value;
                    if (navigator.clipboard) navigator.clipboard.writeText(v);
                    this.classList.add('is-copied'); var b=this; setTimeout(function(){b.classList.remove('is-copied');},1200);
                  ">
                    <svg class="cp-ns-copy-ic" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                    <svg class="cp-ns-copy-ok" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                  </button>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>

      {# Admin account #}
      <div class="subpage-card">
        <div class="box-head"><h2 class="box-title">Admin <b>Account</b></h2></div>

        <div class="cp-field">
          <label for="createorderform-username" class="cp-label">{{ lang('child_panel.form.username') }}</label>
          <input type="text" id="createorderform-username" class="cp-input" name="CreateOrderForm[username]" value="{{ form['username'] }}" aria-required="true" placeholder="admin">
        </div>

        <div class="cp-row2">
          <div class="cp-field">
            <label for="createorderform-password" class="cp-label">{{ lang('child_panel.form.password') }}</label>
            <div class="cp-pass-wrap">
              <input type="password" id="createorderform-password" class="cp-input" name="CreateOrderForm[password]" autocomplete="new-password" aria-required="true">
              <button type="button" class="cp-pass-toggle" aria-label="Show password" onclick="
                var i = document.getElementById('createorderform-password');
                var show = i.type === 'password'; i.type = show ? 'text' : 'password';
                this.classList.toggle('is-on', show);
              ">
                <svg class="cp-eye" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                <svg class="cp-eye-off" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
              </button>
            </div>
          </div>
          <div class="cp-field">
            <label for="createorderform-password_confirm" class="cp-label">{{ lang('child_panel.form.confirm') }}</label>
            <div class="cp-pass-wrap">
              <input type="password" id="createorderform-password_confirm" class="cp-input" name="CreateOrderForm[password_confirm]" autocomplete="new-password" aria-required="true">
              <button type="button" class="cp-pass-toggle" aria-label="Show password" onclick="
                var i = document.getElementById('createorderform-password_confirm');
                var show = i.type === 'password'; i.type = show ? 'text' : 'password';
                this.classList.toggle('is-on', show);
              ">
                <svg class="cp-eye" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                <svg class="cp-eye-off" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
              </button>
            </div>
          </div>
        </div>
      </div>

      {# Price + submit #}
      <div class="subpage-card">
        <div class="cp-checkout">
          <div class="cp-price"><span class="cp-price-amt">{{ price }}</span> <span class="cp-price-per">/ per month</span></div>
          <div class="cp-currency">
            <select class="form-control" id="createorderform-currency" name="CreateOrderForm[currency]" aria-label="Currency">
              {% for currency in currenciesList %}
                <option value="{{ currency['code'] }}" {% if form['currency'] == currency['code'] %}selected{% endif %}>{{ currency['name'] }}{% if currency['code'] %} ({{ currency['code'] }}){% endif %}</option>
              {% endfor %}
            </select>
          </div>
        </div>
        <input type="hidden" name="_csrf" value="{{ csrftoken }}">
        <button type="submit" class="btn btn-primary lp-cta--gradient cp-submit">
          {{ lang('child_panel.form.submit') }}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </button>
      </div>
    </form>

    {# ─── RIGHT: what's included ─── #}
    <aside class="cp-side">
      <div class="subpage-card">
        <div class="box-head"><h2 class="box-title"><b>What's included</b></h2></div>
        <ul class="cp-features">
          <li><svg class="cp-check" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7.99967 14.6673C11.6663 14.6673 14.6663 11.6673 14.6663 8.00065C14.6663 4.33398 11.6663 1.33398 7.99967 1.33398C4.33301 1.33398 1.33301 4.33398 1.33301 8.00065C1.33301 11.6673 4.33301 14.6673 7.99967 14.6673Z"/><path d="M5.16699 7.99993L7.05366 9.8866L10.8337 6.11328"/></svg><span>Custom branded domain</span></li>
          <li><svg class="cp-check" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7.99967 14.6673C11.6663 14.6673 14.6663 11.6673 14.6663 8.00065C14.6663 4.33398 11.6663 1.33398 7.99967 1.33398C4.33301 1.33398 1.33301 4.33398 1.33301 8.00065C1.33301 11.6673 4.33301 14.6673 7.99967 14.6673Z"/><path d="M5.16699 7.99993L7.05366 9.8866L10.8337 6.11328"/></svg><span>Set your own service prices</span></li>
          <li><svg class="cp-check" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7.99967 14.6673C11.6663 14.6673 14.6663 11.6673 14.6663 8.00065C14.6663 4.33398 11.6663 1.33398 7.99967 1.33398C4.33301 1.33398 1.33301 4.33398 1.33301 8.00065C1.33301 11.6673 4.33301 14.6673 7.99967 14.6673Z"/><path d="M5.16699 7.99993L7.05366 9.8866L10.8337 6.11328"/></svg><span>Free SSL certificate</span></li>
          <li><svg class="cp-check" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7.99967 14.6673C11.6663 14.6673 14.6663 11.6673 14.6663 8.00065C14.6663 4.33398 11.6663 1.33398 7.99967 1.33398C4.33301 1.33398 1.33301 4.33398 1.33301 8.00065C1.33301 11.6673 4.33301 14.6673 7.99967 14.6673Z"/><path d="M5.16699 7.99993L7.05366 9.8866L10.8337 6.11328"/></svg><span>Auto order forwarding</span></li>
          <li><svg class="cp-check" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7.99967 14.6673C11.6663 14.6673 14.6663 11.6673 14.6663 8.00065C14.6663 4.33398 11.6663 1.33398 7.99967 1.33398C4.33301 1.33398 1.33301 4.33398 1.33301 8.00065C1.33301 11.6673 4.33301 14.6673 7.99967 14.6673Z"/><path d="M5.16699 7.99993L7.05366 9.8866L10.8337 6.11328"/></svg><span>Payment gateway integration</span></li>
          <li><svg class="cp-check" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7.99967 14.6673C11.6663 14.6673 14.6663 11.6673 14.6663 8.00065C14.6663 4.33398 11.6663 1.33398 7.99967 1.33398C4.33301 1.33398 1.33301 4.33398 1.33301 8.00065C1.33301 11.6673 4.33301 14.6673 7.99967 14.6673Z"/><path d="M5.16699 7.99993L7.05366 9.8866L10.8337 6.11328"/></svg><span>Tickets, blog, FAQ included</span></li>
        </ul>
        <div class="cp-side-foot">Setup takes a few minutes after DNS propagates.</div>
      </div>
    </aside>

  </div>
  {% endif %}
</div>
