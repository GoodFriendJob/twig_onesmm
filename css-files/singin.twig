    var tabs   = goals.querySelectorAll('.lp-goals__tab');
    var panels = goals.querySelectorAll('.lp-goals__panel');
    function activate(i) {
      tabs.forEach(function(t, idx) {
        t.classList.toggle('is-active', idx === i);
        t.setAttribute('aria-selected', idx === i ? 'true' : 'false');
      });
      panels.forEach(function(p, idx) { p.classList.toggle('is-active', idx === i); });
