  {# ── Sticky mobile bar logic ── #}
  <script>
  (function(){
    var bar = document.getElementById('lp-sticky-bar');
    var btn = document.getElementById('lp-sticky-dismiss');
    var form = document.getElementById('signin-form');
    if(!bar || !form) return;
    var SK = 'lp_sticky_dismissed';
    if(sessionStorage.getItem(SK)) return;

    var mq = window.matchMedia('(max-width:760px)');
    if(!mq.matches) return;

    /* hide when sign-in form visible */
    var obs = new IntersectionObserver(function(entries){
      bar.hidden = entries[0].isIntersecting;
    }, {threshold:0.2});
    obs.observe(form);
    bar.hidden = false;

    btn.addEventListener('click', function(){
      bar.hidden = true;
      sessionStorage.setItem(SK, '1');
    });
  })();
  </script>

  {# ── Scroll-reveal + micro-illustration observer ── #}
  <script>
  (function(){
    /* Respect reduced motion */
    if(window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    /* 1. Scroll-reveal: fade in elements with .lp-reveal */
    var revealObs = new IntersectionObserver(function(entries){
      for(var i=0;i<entries.length;i++){
        if(entries[i].isIntersecting){
          entries[i].target.classList.add('lp-reveal--visible');
          revealObs.unobserve(entries[i].target);
        }
      }
    }, {threshold:0.15, rootMargin:'0px 0px -40px 0px'});

    var reveals = document.querySelectorAll('.lp-reveal');
    for(var i=0;i<reveals.length;i++) revealObs.observe(reveals[i]);

    /* 1b. Hero accent underline animation */
    var accent = document.querySelector('.lp-h1-accent');
    if(accent){
      var accentObs = new IntersectionObserver(function(entries){
        if(entries[0].isIntersecting){
          accent.classList.add('is-visible');
          accentObs.disconnect();
        }
      }, {threshold:0.5});
      accentObs.observe(accent);
    }

  })();
  </script>

