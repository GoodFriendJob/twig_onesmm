  <script>
  (function() {
    function makeCarousel(trackId, dotsId, perPage, slideClass) {
      var track = document.getElementById(trackId);
      if (!track) return;
      var dotsWrap = dotsId ? document.getElementById(dotsId) : null;
      var cards = Array.prototype.slice.call(track.children);
      if (!cards.length) return;
      var pages = [];
      for (var i = 0; i < cards.length; i += perPage) {
        pages.push(cards.slice(i, i + perPage));
      }
      track.innerHTML = '';
      pages.forEach(function(group) {
        var slide = document.createElement('div');
        slide.className = slideClass;
        group.forEach(function(card) { slide.appendChild(card); });
        track.appendChild(slide);
      });
      if (dotsWrap) {
        dotsWrap.innerHTML = '';
        pages.forEach(function(_, i) {
          var btn = document.createElement('button');
          btn.className = 'lp-reviews__dot' + (i === 0 ? ' is-active' : '');
          btn.setAttribute('aria-label', 'Page ' + (i + 1));
          dotsWrap.appendChild(btn);
        });
      }
      var slides = track.children;
      var dots = dotsWrap ? dotsWrap.querySelectorAll('.lp-reviews__dot') : [];
      var cur = 0;
      function go(n) {
        cur = (n + slides.length) % slides.length;
        track.style.transform = 'translateX(-' + (cur * 100) + '%)';
        dots.forEach(function(d, i) { d.classList.toggle('is-active', i === cur); });
      }
      dots.forEach(function(d, i) { d.addEventListener('click', function() { go(i); }); });
      var swipeStartX = 0;
      var swipeStartY = 0;
      var swipeLocked = false;
      track.addEventListener('touchstart', function(e) {
        swipeStartX = e.touches[0].clientX;
        swipeStartY = e.touches[0].clientY;
        swipeLocked = false;
      }, { passive: true });
      track.addEventListener('touchmove', function(e) {
        if (swipeLocked) return;
        var dx = e.touches[0].clientX - swipeStartX;
        var dy = e.touches[0].clientY - swipeStartY;
        if (Math.abs(dx) > Math.abs(dy)) {
          e.preventDefault();
        } else {
          swipeLocked = true;
        }
      }, { passive: false });
      track.addEventListener('touchend', function(e) {
        if (swipeLocked) return;
        var dx = e.changedTouches[0].clientX - swipeStartX;
        if (Math.abs(dx) > 40) {
          go(dx < 0 ? cur + 1 : cur - 1);
        }
      }, { passive: true });
    }
    var section = document.getElementById('lp-reviews');
    if (!section) return;
    var tabs = section.querySelectorAll('#lp-rtabs .lp-reviews__tab');
    var panels = section.querySelectorAll(':scope > .lp-container > .lp-reviews__panel');
    tabs.forEach(function(t) {
      t.addEventListener('click', function() {
        tabs.forEach(function(x) { x.classList.remove('is-active'); x.setAttribute('aria-selected', 'false'); });
        panels.forEach(function(p) { p.classList.remove('is-active'); });
        t.classList.add('is-active');
        t.setAttribute('aria-selected', 'true');
        var target = document.getElementById('lp-rtab-' + t.getAttribute('data-rtab'));
        if (target) target.classList.add('is-active');
      });
    });
    makeCarousel('lp-rvid-track', 'lp-rvid-dots', 3, 'lp-reviews__vslide');
    makeCarousel('lp-rwrit-track', 'lp-rwrit-dots', 6, 'lp-reviews__wslide');
    makeCarousel('lp-rplat-g-track', 'lp-rplat-g-dots', 6, 'lp-reviews__wslide');
    makeCarousel('lp-rplat-ph-track', 'lp-rplat-ph-dots', 6, 'lp-reviews__wslide');
    makeCarousel('lp-rplat-tp-track', 'lp-rplat-tp-dots', 6, 'lp-reviews__wslide');
    var subtabs = section.querySelectorAll('#lp-rplat-subtabs .lp-reviews__subtab');
    var subpanels = section.querySelectorAll('#lp-rtab-platform .lp-reviews__subpanel');
    subtabs.forEach(function(st) {
      st.addEventListener('click', function() {
        subtabs.forEach(function(x) { x.classList.remove('is-active'); });
        subpanels.forEach(function(p) { p.classList.remove('is-active'); });
        st.classList.add('is-active');
        var target = document.getElementById('lp-rp-' + st.getAttribute('data-psubtab'));
        if (target) target.classList.add('is-active');
      });
    });
  })();
  </script>

