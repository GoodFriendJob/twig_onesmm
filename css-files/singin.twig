{# ── Redirect login errors back to /signup#signin when user came from there ── #}
{% if error %}
<script>
(function(){
  if(sessionStorage.getItem('auth_from')==='signup'){
    sessionStorage.removeItem('auth_from');
    sessionStorage.setItem('signin_error', {{ errorMessage|json_encode|raw }});
    window.location.replace('{{ page_url('signup') }}#signin');
  }
})();
</script>
{% endif %}

