        {name:'Comments',     shortName:'Comments',  rateNum:6.00, platform:'instagram',
         tiers:[10,25,50,100,250,500]},
        {name:'Story Views',  shortName:'Stories',   rateNum:0.05, platform:'instagram',
         tiers:[100,500,1000,5000,10000,25000]},

        {name:'Members',      shortName:'Members',   rateNum:0.13, platform:'telegram',
         tiers:[500,1000,2500,5000,10000,25000]},
        {name:'Premium Members', shortName:'Premium', rateNum:2.81, platform:'telegram',
         tiers:[500,1000,2500,5000,10000,25000]},
        {name:'Post Views',   shortName:'Views',     rateNum:0.01, platform:'telegram',
         tiers:[1000,5000,10000,50000,100000,500000]},
        {name:'Reactions',    shortName:'Reactions',  rateNum:0.10, platform:'telegram',
         tiers:[100,500,1000,2500,5000,10000]},

        {name:'Followers',    shortName:'Followers',  rateNum:0.80, platform:'tiktok',
         tiers:[500,1000,2500,5000,10000,25000,50000]},
        {name:'Likes',        shortName:'Likes',      rateNum:0.30, platform:'tiktok',
         tiers:[100,500,1000,2500,5000,10000,25000]},
        {name:'Views',        shortName:'Views',      rateNum:0.04, platform:'tiktok',
         tiers:[1000,5000,10000,50000,100000,500000]},
        {name:'Shares',       shortName:'Shares',     rateNum:1.20, platform:'tiktok',
         tiers:[100,500,1000,2500,5000,10000]},

        {name:'Subscribers',  shortName:'Subscribers', rateNum:1.10, platform:'youtube',
         tiers:[100,500,1000,2500,5000,10000,25000]},
        {name:'Views',        shortName:'Views',       rateNum:0.62, platform:'youtube',
         tiers:[500,1000,5000,10000,25000,50000]},
        {name:'Likes',        shortName:'Likes',       rateNum:0.90, platform:'youtube',
         tiers:[100,500,1000,2500,5000,10000]},
        {name:'Watch Time',   shortName:'Watch Time',  rateNum:3.50, platform:'youtube',
         tiers:[500,1000,2500,5000,10000,25000]},

        {name:'Page Followers', shortName:'Followers', rateNum:0.45, platform:'facebook',
         tiers:[500,1000,2500,5000,10000,25000,50000]},
        {name:'Page Likes',   shortName:'Likes',       rateNum:0.50, platform:'facebook',
         tiers:[500,1000,2500,5000,10000,25000]},
        {name:'Post Likes',   shortName:'Post Likes',  rateNum:0.20, platform:'facebook',
         tiers:[100,500,1000,2500,5000,10000]},
        {name:'Video Views',  shortName:'Views',       rateNum:0.03, platform:'facebook',
         tiers:[1000,5000,10000,50000,100000,500000]},

        {name:'Followers',    shortName:'Followers',   rateNum:0.75, platform:'twitter',
         tiers:[500,1000,2500,5000,10000,25000,50000]},
        {name:'Likes',        shortName:'Likes',       rateNum:0.40, platform:'twitter',
         tiers:[100,500,1000,2500,5000,10000]},
        {name:'Retweets',     shortName:'Retweets',    rateNum:0.60, platform:'twitter',
         tiers:[100,500,1000,2500,5000,10000]},
        {name:'Views',        shortName:'Views',       rateNum:0.02, platform:'twitter',
         tiers:[1000,5000,10000,50000,100000,500000]},

        {name:'Followers',    shortName:'Followers',   rateNum:1.50, platform:'twitch',
         tiers:[500,1000,2500,5000,10000,25000]},
        {name:'Views',        shortName:'Views',       rateNum:0.08, platform:'twitch',
         tiers:[1000,5000,10000,50000,100000]},

        {name:'Members',      shortName:'Members',     rateNum:0.90, platform:'discord',
         tiers:[100,500,1000,2500,5000,10000]},
        {name:'Online Members', shortName:'Online',    rateNum:1.20, platform:'discord',
         tiers:[100,500,1000,2500,5000]},

        {name:'Plays',        shortName:'Plays',       rateNum:0.05, platform:'spotify',
         tiers:[1000,5000,10000,50000,100000,500000]},
        {name:'Followers',    shortName:'Followers',    rateNum:0.60, platform:'spotify',
         tiers:[500,1000,2500,5000,10000,25000]},
        {name:'Monthly Listeners', shortName:'Listeners', rateNum:0.10, platform:'spotify',
         tiers:[1000,5000,10000,50000,100000]}
      ];

      function fmtNum(n){ return parseInt(n,10).toLocaleString('en-US'); }
      function fmtPrice(n){
        if(n < 0.01) return '$' + n.toFixed(4);
        if(n < 1) return '$' + n.toFixed(3);
        return '$' + n.toFixed(2);
      }

      function getFiltered(){
        return allServices.filter(function(s){ return s.platform === currentPlatform; });
      }

      function getCurrentService(){
        var filtered = getFiltered();
        return filtered[currentServiceIdx] || filtered[0] || null;
      }

      function updatePrice(){
        var svc = getCurrentService();
        if(!svc) return;
        var tierIdx = parseInt(slider.value, 10);
        var qty = svc.tiers[tierIdx] || svc.tiers[0];
        var price = (svc.rateNum / 1000) * qty;
        qtyDisplay.textContent = fmtNum(qty);
        rateEl.textContent = fmtPrice(svc.rateNum) + ' / K';
        priceEl.textContent = fmtPrice(price);
        var pct = svc.tiers.length > 1 ? (tierIdx / (svc.tiers.length - 1)) * 100 : 0;
        slider.style.setProperty('--fill', pct + '%');
      }

      function renderTierLabels(){
        var svc = getCurrentService();
        if(!svc) return;
        tierLabels.innerHTML = '';
        svc.tiers.forEach(function(t){
          var span = document.createElement('span');
          span.textContent = t >= 1000 ? (t/1000) + 'K' : t;
          tierLabels.appendChild(span);
        });
      }

      function renderServices(){
        var filtered = getFiltered();
        servicesContainer.innerHTML = '';
        if(!filtered.length) return;
        filtered.forEach(function(svc, idx){
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'lp-calc2__svc-pill' + (idx === 0 ? ' is-active' : '');
          btn.textContent = svc.shortName;
          btn.addEventListener('click', function(){
            var prev = servicesContainer.querySelector('.lp-calc2__svc-pill.is-active');
            if(prev) prev.classList.remove('is-active');
            btn.classList.add('is-active');
            currentServiceIdx = idx;
            slider.max = svc.tiers.length - 1;
            slider.value = Math.min(2, svc.tiers.length - 1);
            renderTierLabels();
            updatePrice();
          });
          servicesContainer.appendChild(btn);
        });
        currentServiceIdx = 0;
        var first = filtered[0];
        slider.max = first.tiers.length - 1;
        slider.value = Math.min(2, first.tiers.length - 1);
        renderTierLabels();
        updatePrice();
      }

      /* ── Platform button clicks ── */
      for(var i = 0; i < platformBtns.length; i++){
        platformBtns[i].addEventListener('click', function(){
          for(var j = 0; j < platformBtns.length; j++) platformBtns[j].classList.remove('is-active');
          this.classList.add('is-active');
          currentPlatform = this.getAttribute('data-platform');
          renderServices();
        });
      }

      slider.addEventListener('input', updatePrice);

      /* ── Platform card click → scroll to calc ── */
      document.addEventListener('click', function(e){
        var card = e.target.closest && e.target.closest('.lp-platform');
        if(!card) return;
        var name = card.querySelector('.lp-platform__name');
        if(!name) return;
        var plat = name.textContent.trim().toLowerCase().replace(/\s.*/, '');
        var tab = track.querySelector('.lp-calc2__plat[data-platform="'+plat+'"]');
        if(tab){
          e.preventDefault();
          tab.click();
          document.getElementById('pricing').scrollIntoView({behavior:'smooth', block:'start'});
        }
      });

      renderServices();
    })();
    </script>
  </section>

  {# ───────────────────────── 5. HAPPENING RIGHT NOW ───────────────────────── #}
  <section class="lp-section">
    <div class="lp-container">
      <div class="lp-section__head lp-section__head--left lp-reveal">
        <h2 class="lp-h2">{{ L_sec_live }}</h2>
        <p class="lp-section__sub">{{ L_sec_live_sub }}</p>
      </div>
      <div class="lp-feed lp-reveal" id="lp-live-feed">
        <div class="lp-feed__head">
          <span class="lp-live-dot"></span>
          <span class="lp-feed__title">Live Activity</span>
          <span class="lp-feed__hint tabular" id="lp-feed-counter">52,805+ Orders Processed</span>
        </div>
        <div class="lp-feed__rows" id="lp-feed-rows">
          {# JS populates this #}
        </div>
      </div>

      <script>
      (function(){
        /* ── skip live feed on slow connections ── */
        var conn = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
        if(conn && (conn.saveData || /^(slow-2g|2g)$/.test(conn.effectiveType))){
          var feedEl = document.getElementById('lp-live-feed');
          if(feedEl) feedEl.style.display = 'none';
          return;
        }

        /* ── CONFIG ── */
        var API_BASE = 'https://api.justboosted.com/api';
        var VISIBLE  = 8;
        var PLATFORM_FILTER = /instagram|telegram/i;

        /* ── state ── */
        var pool    = [];
        var ready   = false;
        var rows    = document.getElementById('lp-feed-rows');
        var hintEl         = document.getElementById('lp-feed-counter');
        var heroCountEl    = document.getElementById('lp-hero-count');
        var active  = [];
        var recent  = [];

        /* tempo from backend — defaults until first API response */
        var tempo = {burstMin:1, burstMax:2, delayMin:3000, delayMax:6000};
        var displayCount = 0;     /* current counter value shown */
        var msPerOrder   = 5000;  /* ms between +1 increments — backend overrides */
        var counterTimer = null;

        /* ── helpers ── */
        function rand(a,b){ return Math.floor(Math.random()*(b-a+1))+a; }
        function fmt(n){ return n>=1000 ? n.toLocaleString('en-US') : String(n); }
        function timeLabel(s){ return s<60 ? s+'s ago' : Math.floor(s/60)+'m ago'; }

        function pickService(){
          if(!pool.length) return null;
          var idx, tries=0;
          do { idx = rand(0, pool.length-1); tries++; }
          while(recent.indexOf(idx)!==-1 && tries<20);
          recent.push(idx);
          if(recent.length>3) recent.shift();
          return pool[idx];
        }

        function roundQty(lo,hi){
          var raw = rand(lo,hi);
          if(raw>=10000) return Math.round(raw/1000)*1000;
          if(raw>=1000)  return Math.round(raw/100)*100;
          if(raw>=100)   return Math.round(raw/50)*50;
          return raw;
        }

        var ST = [
          {c:'lp-pill--ok',t:'{{ L_completed }}'},{c:'lp-pill--ok',t:'{{ L_completed }}'},
          {c:'lp-pill--ok',t:'{{ L_completed }}'},{c:'lp-pill--ok',t:'{{ L_completed }}'},
          {c:'lp-pill--ok',t:'{{ L_completed }}'},{c:'lp-pill--ok',t:'{{ L_completed }}'},
          {c:'lp-pill--prog',t:'{{ L_in_progress }}'},{c:'lp-pill--prog',t:'{{ L_in_progress }}'},
          {c:'lp-pill--refill',t:'{{ L_auto_refill }}'},
          {c:'lp-pill--part',t:'{{ L_partial }}'}
        ];

        function makeRow(ageSec){
          var svc = pickService();
          if(!svc) return null;
          var st  = ST[rand(0,ST.length-1)];
          var qty = roundQty(svc.lo, svc.hi);
          var el  = document.createElement('div');
          var idNum = rand(1, 999);
          var idStr = idNum < 10 ? '00'+idNum : idNum < 100 ? '0'+idNum : String(idNum);
          el.className = 'lp-feed__row lp-feed__row--enter';
          el.innerHTML =
            '<span class="lp-feed__id tabular">'+idStr+'</span>'+
            '<span class="lp-feed__svc">'+svc.s+'</span>'+
            '<span class="lp-feed__qty tabular">'+fmt(qty)+'</span>'+
            '<span class="lp-feed__pill '+st.c+'">'+st.t+'</span>'+
            '<span class="lp-feed__time tabular" data-born="'+ageSec+'">'+timeLabel(ageSec)+'</span>';
          return {el:el};
        }

        function addRow(ageSec){
          var r = makeRow(ageSec);
          if(!r) return;
          rows.insertBefore(r.el, rows.firstChild);
          active.unshift(r);
          requestAnimationFrame(function(){ r.el.classList.remove('lp-feed__row--enter'); });
          while(active.length > VISIBLE){
            var old = active.pop();
            old.el.classList.add('lp-feed__row--exit');
            (function(el){ setTimeout(function(){ if(el.parentNode) el.parentNode.removeChild(el); }, 400); })(old.el);
          }
        }

        function burst(){
          if(!pool.length) return;
          var count = rand(tempo.burstMin, tempo.burstMax);
          for(var i=0;i<count;i++){
            (function(delay,idx){
              setTimeout(function(){ addRow(rand(1,4+idx*2)); }, delay);
            })(i*180, i);
          }
        }

        function seed(){
          if(!pool.length) return;
          for(var i=0;i<VISIBLE;i++){
            var age = rand(2,8) + i*rand(12,28);
            var r = makeRow(age);
            if(!r) continue;
            rows.appendChild(r.el);
            active.push(r);
            (function(el){ requestAnimationFrame(function(){ el.classList.remove('lp-feed__row--enter'); }); })(r.el);
          }
          /* Lock container height so add/remove cycles don't shift the page */
          requestAnimationFrame(function(){ rows.style.height = rows.offsetHeight + 'px'; });
        }

        function updateTimes(){
          var spans = rows.querySelectorAll('[data-born]');
          for(var i=0;i<spans.length;i++){
            var b = parseInt(spans[i].getAttribute('data-born'),10)+1;
            spans[i].setAttribute('data-born', b);
            spans[i].textContent = timeLabel(b);
          }
        }

        /* ── schedule bursts using backend tempo ── */
        function scheduleBurst(){
          var delay = rand(tempo.delayMin, tempo.delayMax);
          setTimeout(function(){
            burst();
            scheduleBurst();
          }, delay);
        }

        /* ── scrape /services for real service names — cached in localStorage for 24h ── */
        function loadServices(){
          var CACHE_KEY = 'lp_services_v1';
          var CACHE_TTL = 86400000; /* 24h */
          try {
            var hit = localStorage.getItem(CACHE_KEY);
            if(hit){
              var c = JSON.parse(hit);
              if(Date.now() - c.ts < CACHE_TTL && c.data.length){
                pool = c.data;
                if(!ready && pool.length){ ready=true; seed(); scheduleBurst(); }
                return;
              }
            }
          } catch(e){}
          var xhr = new XMLHttpRequest();
          xhr.open('GET', '/services', true);
          xhr.onload = function(){
            if(xhr.status!==200) return;
            var doc = new DOMParser().parseFromString(xhr.responseText, 'text/html');
            var cells = doc.querySelectorAll('[data-filter-table-service-name]');
            var found = [];
            var seen  = {};
            for(var i=0;i<cells.length;i++){
              var name = cells[i].textContent.trim();
              if(!PLATFORM_FILTER.test(name)) continue;
              if(seen[name]) continue;
              seen[name] = true;
              var lo=500, hi=10000;
              if(/view|watch/i.test(name))                        { lo=5000; hi=200000; }
              else if(/like|reaction|save/i.test(name))           { lo=1000; hi=50000;  }
              else if(/comment/i.test(name))                      { lo=10;   hi=500;    }
              else if(/share|repost/i.test(name))                 { lo=100;  hi=5000;   }
              else if(/follower|member|subscriber/i.test(name))   { lo=500;  hi=30000;  }
              else if(/boost/i.test(name))                        { lo=10;   hi=100;    }
              found.push({s:name, lo:lo, hi:hi});
            }
            pool = found;
            if(!ready && pool.length){ ready=true; seed(); scheduleBurst(); }
            try { localStorage.setItem(CACHE_KEY, JSON.stringify({ts:Date.now(), data:pool})); } catch(e){}
          };
          xhr.send();
        }

        /* ── live counter tick — increments by 1 every msPerOrder ms ── */
        function startCounterTick(){
          if(counterTimer) clearInterval(counterTimer);
          counterTimer = setInterval(function(){
            if(!displayCount || !hintEl) return;
            displayCount++;
            hintEl.textContent = fmt(displayCount)+'+ Orders Processed';
            if(heroCountEl) heroCountEl.textContent = fmt(displayCount);
          }, msPerOrder);
        }

        /* ── poll backend for count + tempo ── */
        var statsFailed = 0;
        function fetchStats(){
          if(!API_BASE) return;
          if(statsFailed >= 3) return; /* stop polling after 3 consecutive failures */
          var xhr = new XMLHttpRequest();
          xhr.open('GET', API_BASE+'/public/stats', true);
          xhr.timeout = 8000;
          xhr.onload = function(){
            if(xhr.status!==200){ statsFailed++; return; }
            statsFailed = 0;
            try{
              var d = JSON.parse(xhr.responseText);
              /* sync counter to backend's authoritative value */
              if(d.totalOrders){
                displayCount = d.totalOrders;
                if(hintEl) hintEl.textContent = fmt(displayCount)+'+ Orders Processed';
                if(heroCountEl) heroCountEl.textContent = fmt(displayCount);
              }
              /* adopt backend tempo */
              if(d.tempo){
                tempo.burstMin = d.tempo.burstMin || tempo.burstMin;
                tempo.burstMax = d.tempo.burstMax || tempo.burstMax;
                tempo.delayMin = d.tempo.delayMin || tempo.delayMin;
                tempo.delayMax = d.tempo.delayMax || tempo.delayMax;
              }
              /* adopt tick rate — restart ticker at new speed */
              if(d.msPerOrder && d.msPerOrder !== msPerOrder){
                msPerOrder = d.msPerOrder;
                startCounterTick();
              }
            }catch(e){ statsFailed++; }
          };
          xhr.onerror = function(){ statsFailed++; };
          xhr.ontimeout = function(){ statsFailed++; };
          xhr.send();
        }

        /* ── boot ── */
        setInterval(updateTimes, 5000);
        loadServices();
        fetchStats();
        startCounterTick();
        setInterval(fetchStats, 30000);
      })();
      </script>
