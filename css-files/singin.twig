        </p>

        <div class="lp-hero__cta-bar">
          <a href="{{ page_url('signup') }}" class="lp-cta lp-cta--gradient">
            {{ L_hero_cta1 }} 

            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
          <a href="{{ page_url('services') }}" class="lp-cta lp-cta--secondary lp-cta--secondary-no-bg">
            Explore Services
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#ff6255" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
