<script>
(function() {
  var thumb = document.querySelector('.lp-video-thumb');
  var modal = document.getElementById('lp-hero-video-modal');
  if (!thumb || !modal) return;
  var video    = modal.querySelector('video');
  var backdrop = modal.querySelector('.lp-video-modal__backdrop');
  var closeBtn = modal.querySelector('.lp-video-modal__close');

  function openModal() {
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    if (video) video.play();
    closeBtn.focus();
  }
  function closeModal() {
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    if (video) { video.pause(); video.currentTime = 0; }
    thumb.focus();
  }

  thumb.addEventListener('click', openModal);
  backdrop.addEventListener('click', closeModal);
  closeBtn.addEventListener('click', closeModal);
  document.addEventListener('keydown', function(e) {
    if (modal.getAttribute('aria-hidden') === 'false' && e.key === 'Escape') closeModal();
  });
})();
</script>
