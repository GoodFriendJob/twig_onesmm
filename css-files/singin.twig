    {# ───────────────────────── 1b. SIGN-IN BAR ───────────────────────── #}
  <section class="lp-signinbar" id="signin-form">
    <div class="lp-container">
      <div class="lp-signinbar__card">

        <div class="lp-signinbar__content">
          {% if success %}
            <div class="alert alert-success lp-signinbar__alert">{{ successMessage }}</div>
          {% endif %}
          {% if error %}
            <div class="alert alert-danger lp-signinbar__alert">{{ errorMessage }}</div>
          {% endif %}

          <form method="post" action="{{ page['url'] }}" class="lp-signinbar__form">
            <input type="hidden" name="_csrf" value="{{ csrftoken }}">
            <div class="lp-signinbar__row">
              <label for="lp-username" class="sr-only">{{ L_username }}</label>
              <input type="text" name="LoginForm[username]" id="lp-username" class="lp-signinbar__input" placeholder="{{ L_username }}" autocomplete="username" required>
              <label for="lp-password" class="sr-only">{{ L_password }}</label>
              <input type="password" name="LoginForm[password]" id="lp-password" class="lp-signinbar__input" placeholder="{{ L_password }}" autocomplete="current-password" required>
              <button type="submit" class="lp-signinbar__submit lp-signinbar__submit--gradient">
                {{ L_submit }}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
              </button>
              {% if googleSignIn %}
                <div id="g_id_onload"
                  data-client_id="{{ googleClientId }}"
                  data-login_uri="{{ googleSignInRedirectUrl }}"
                  data-auto_prompt="false"
                  data-_csrf="{{ csrftoken }}">
                </div>
                <button type="button" class="lp-signinbar__google" id="lp-google-trigger">
                  <span class="lp-signinbar__google-inner">
                    <svg width="18" height="18" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
                    {{ L_google_signin }}
                  </span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#ff6255" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                </button>
                {# Hidden GSI rendered button for programmatic click #}
                <div class="g_id_signin" id="lp-gsi-hidden"
                  data-type="icon"
                  data-size="large"
                  data-shape="square"
                  data-theme="outline"
                  style="position:absolute;opacity:0;pointer-events:none;width:0;height:0;overflow:hidden;">
                </div>
              {% endif %}
            </div>
            {% if captcha %}
              <div class="lp-signinbar__captcha">{{ captcha|raw }}</div>
            {% endif %}
            <div class="lp-signinbar__meta">
              {% if registration %}
                <span class="lp-signinbar__meta-left">{{ L_no_account }} <a href="{{ page_url('signup') }}" class="lp-signinbar__meta-link">{{ L_signup }}</a></span>
              {% endif %}
              <span class="lp-signinbar__meta-left">{{ L_forgot }} <a href="{{ page_url('resetpassword') }}" class="lp-signinbar__meta-link">{{ L_recover }}</a></span>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
  <script>
  (function(){
    var trigger = document.getElementById('lp-google-trigger');
    if (!trigger) return;
    trigger.addEventListener('click', function() {
      var hidden = document.getElementById('lp-gsi-hidden');
      if (hidden) {
        var btn = hidden.querySelector('[role="button"], iframe, div[tabindex]');
        if (btn) btn.click();
      }
    });
  })();
  </script>

