      var L_per1k = '{{ L_calc_per_1k }}';
      var carouselPage = 0;

      /* ── Carousel logic ── */
      function getVisibleCount(){
        var w = carousel.offsetWidth;
        if(w < 340) return 3;
        if(w < 500) return 4;
        if(w < 650) return 5;
        return 6;
      }
      function getTotalPages(){ return Math.max(1, Math.ceil(platformBtns.length / getVisibleCount())); }

      function renderDots(){
        var total = getTotalPages();
        dotsWrap.innerHTML = '';
        for(var i = 0; i < total; i++){
          var dot = document.createElement('button');
          dot.type = 'button';
          dot.className = 'lp-calc2__dot' + (i === carouselPage ? ' is-active' : '');
          dot.setAttribute('aria-label', 'Page ' + (i+1));
          (function(idx){ dot.addEventListener('click', function(){ carouselPage = idx; scrollCarousel(); }); })(i);
          dotsWrap.appendChild(dot);
        }
      }

      function scrollCarousel(){
        var visible = getVisibleCount();
        var total = getTotalPages();
        if(carouselPage >= total) carouselPage = total - 1;
        if(carouselPage < 0) carouselPage = 0;
        var cardW = platformBtns[0].offsetWidth + 10; /* card + gap */
        var offset = carouselPage * visible * cardW;
        var maxOffset = track.scrollWidth - carousel.offsetWidth;
        if(offset > maxOffset) offset = maxOffset;
        track.style.transform = 'translateX(-' + offset + 'px)';
        prevBtn.style.opacity = carouselPage === 0 ? '0.3' : '1';
        prevBtn.style.pointerEvents = carouselPage === 0 ? 'none' : 'auto';
        nextBtn.style.opacity = carouselPage >= total - 1 ? '0.3' : '1';
        nextBtn.style.pointerEvents = carouselPage >= total - 1 ? 'none' : 'auto';
        /* update dots */
        var dots = dotsWrap.querySelectorAll('.lp-calc2__dot');
        for(var i = 0; i < dots.length; i++){
          dots[i].classList.toggle('is-active', i === carouselPage);
        }
      }

      prevBtn.addEventListener('click', function(){ carouselPage--; scrollCarousel(); });
      nextBtn.addEventListener('click', function(){ carouselPage++; scrollCarousel(); });
      renderDots();
      scrollCarousel();
      window.addEventListener('resize', function(){ renderDots(); scrollCarousel(); });

      /* ── Pricing data ── */
