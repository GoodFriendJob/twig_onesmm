  {# ── VIDEO CAROUSEL JS COMMENTED OUT — uncomment when real videos are ready ──
  <script>
  (function(){
    var vtestiInit = false;
    var tabBtns = document.querySelectorAll('.lp-review-tab');
    var panels = document.querySelectorAll('.lp-review-panel');

    for (var i = 0; i < tabBtns.length; i++) {
      tabBtns[i].addEventListener('click', function() {
        var tab = this.dataset.tab;
        for (var j = 0; j < tabBtns.length; j++)
          tabBtns[j].classList.toggle('is-active', tabBtns[j].dataset.tab === tab);
        for (var j = 0; j < panels.length; j++)
          panels[j].classList.toggle('is-active', panels[j].id === 'lp-tab-' + tab);

        if (tab === 'video' && !vtestiInit) {
          vtestiInit = true;
          requestAnimationFrame(function(){
            requestAnimationFrame(function(){ initVtestiCarousel(); });
          });
        } else if (tab === 'video') {
          window.dispatchEvent(new Event('resize'));
        }
      });
    }

    function initVtestiCarousel() {
      var track = document.getElementById('lp-vtesti-track');
      if (!track) return;
      var cards = track.querySelectorAll('.lp-vtesti__card');
      var prevBtn = document.getElementById('lp-vtesti-prev');
      var nextBtn = document.getElementById('lp-vtesti-next');
      var dotsWrap = document.getElementById('lp-vtesti-dots');
      var current = 0;
      var perView = 4;
      var gap = 20;

      function getPerView() {
        var w = window.innerWidth;
        if (w < 640) return 1;
        if (w < 1024) return 2;
        if (w < 1201) return 3;
        return 4;
      }

      function buildDots() {
        perView = getPerView();
        var maxIdx = Math.max(0, cards.length - perView);
        dotsWrap.innerHTML = '';
        for (var i = 0; i <= maxIdx; i++) {
          var d = document.createElement('button');
          d.className = 'lp-vtesti__dot' + (i === current ? ' lp-vtesti__dot--active' : '');
          d.setAttribute('aria-label', 'Go to slide ' + (i + 1));
          d.dataset.idx = i;
          d.addEventListener('click', function() { goTo(parseInt(this.dataset.idx)); });
          dotsWrap.appendChild(d);
        }
      }

      function goTo(idx) {
        perView = getPerView();
        var maxIdx = Math.max(0, cards.length - perView);
        current = Math.max(0, Math.min(idx, maxIdx));
        var cardW = cards[0].offsetWidth;
        track.style.transform = 'translateX(-' + current * (cardW + gap) + 'px)';
        var dots = dotsWrap.querySelectorAll('.lp-vtesti__dot');
        for (var i = 0; i < dots.length; i++) {
          dots[i].className = 'lp-vtesti__dot' + (i === current ? ' lp-vtesti__dot--active' : '');
        }
        prevBtn.style.opacity = current === 0 ? '0.3' : '1';
        prevBtn.style.pointerEvents = current === 0 ? 'none' : 'auto';
        nextBtn.style.opacity = current >= maxIdx ? '0.3' : '1';
        nextBtn.style.pointerEvents = current >= maxIdx ? 'none' : 'auto';
      }

      prevBtn.addEventListener('click', function() { goTo(current - 1); });
      nextBtn.addEventListener('click', function() { goTo(current + 1); });
      window.addEventListener('resize', function() { buildDots(); goTo(current); });
      buildDots();
      goTo(0);

      track.addEventListener('click', function(e) {
        var play = e.target.closest('.lp-vtesti__play');
        if (!play) return;
        var card = play.closest('.lp-vtesti__card');
        var vid = card.dataset.videoId;
        if (!vid || vid.indexOf('PLACEHOLDER') === 0) return;
        var iframe = document.createElement('iframe');
        iframe.src = 'https://www.youtube.com/embed/' + vid + '?autoplay=1&rel=0';
        iframe.setAttribute('allow', 'autoplay; encrypted-media');
        iframe.setAttribute('allowfullscreen', '');
        iframe.className = 'lp-vtesti__iframe';
        card.appendChild(iframe);
      });
    }
  })();
  </script>
  ── END VIDEO CAROUSEL JS #}


