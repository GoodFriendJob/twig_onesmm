{# viewticket.twig — Pulse styled
   Variables: site.rtl, ticket, messageList, canAddMessage, error, errorMessage, csrftoken, lang(...), sliceUrl()
#}
<div class="viewticket-page subscriptions-page">

  <div class="page-header">
    <div>
      <a href="{{ page_url('tickets') }}" class="back-link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        Back to tickets
      </a>
      <h1 class="h1 ticket-title">{{ ticket['thema'] }}</h1>
    </div>
  </div>

  <div class="ticket-thread {% if site['rtl'] %}rtl-content{% endif %}">

    {% if messageList %}
      {% for message in messageList %}
        {% if message['support'] == 0 %}
          <div class="ticket-row ticket-row-mine">
            <div class="ticket-bubble ticket-bubble-mine">
              <div class="ticket-bubble-header">
                <strong>{{ message['author'] }}</strong>
                <small class="muted">{{ message['time'] }}</small>
              </div>
              <div class="ticket-bubble-body">{{ message['message'] }}</div>
              {% if message['files'] %}
                <div class="ticket-bubble-files">
                  {% for file in message['files'] %}
                    <a class="ticket-file" href="{{ file['url'] }}" title="{{ file['name'] }}" target="_blank" rel="noopener noreferrer nofollow">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                      <span>{{ sliceUrl(file['name']) }}</span>
                    </a>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          </div>
        {% else %}
          <div class="ticket-row ticket-row-support">
            <div class="ticket-avatar">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 2 7l10 5 10-5-10-5z"/><path d="m2 17 10 5 10-5"/><path d="m2 12 10 5 10-5"/></svg>
            </div>
            <div class="ticket-bubble ticket-bubble-support">
              <div class="ticket-bubble-header">
                <strong>{{ message['author'] }}</strong>
                <small class="muted">{{ message['time'] }}</small>
                <span class="status-pill status-1">Support</span>
              </div>
              <div class="ticket-bubble-body">{{ message['message'] }}</div>
              {% if message['files'] %}
                <div class="ticket-bubble-files">
                  {% for file in message['files'] %}
                    <a class="ticket-file" href="{{ file['url'] }}" title="{{ file['name'] }}" target="_blank" rel="noopener noreferrer nofollow">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                      <span>{{ sliceUrl(file['name']) }}</span>
                    </a>
                  {% endfor %}
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    {% endif %}

    {% if canAddMessage %}
      <div class="card ticket-reply">
        <div class="card-body">
          <div class="h3" style="margin: 0 0 14px; font-size: 14px; color: var(--ink-1);">Reply</div>
          <form {% if site['rtl'] %}class="rtl-form"{% endif %} method="post" action="">
            {% if error %}
              <div class="alert alert-dismissible alert-danger {% if site['rtl'] %}rtl-alert{% endif %}">
                <button type="button" class="close" data-dismiss="alert">&times;</button>
                {{ errorMessage }}
              </div>
            {% endif %}
            <div class="form-group">
              <label for="message" class="control-label">{{ lang('tickets.message') }}</label>
              <textarea id="message" rows="5" class="form-control" name="TicketMessageForm[message]" placeholder="Type your reply…"></textarea>
            </div>
            <div class="form-group">
              <div
                class="tickets-uploader"
                data-rtl="{% if site['rtl'] %}true{% else %}false{% endif %}"
                data-lang-button-attach="{{ lang('tickets.button.attach') }}"
                data-lang-file-format-incorrect="{{ lang('tickets.error.file_format.incorrect') }}"
                data-lang-file-size-incorrect="{{ lang('tickets.error.file_size.incorrect') }}"
              ></div>
            </div>
            <input type="hidden" name="_csrf" value="{{ csrftoken }}">
            <button type="submit" class="btn btn-primary auth-submit">
              {{ lang('tickets.button.reply') }}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </button>
          </form>
        </div>
      </div>
    {% endif %}

  </div>

</div>
