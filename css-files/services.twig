{# services.twig — "Services List" (matches new design)
   Same variable contract + Perfect Panel JS hooks preserved:
     serviceCategoryList[], converted, serviceDescription, servicesText,
     user.auth, user.favorite_services, site.*, lang(...)
   Hooks: [data-filter-platform], [data-filter-table-category-id],
          [data-filter-table-service-id/name], [data-search-service], #service-table,
          [data-favorite-service-id], #currencies-list/#currencies-item
#}
<div class="subpage services-page">

  <div class="subpage-head">
    <h1 class="subpage-title"><span>Services</span> List</h1>
  </div>

  {# ─── Choose a Platform (neworder-style chips + More/Less) ─── #}
  <div class="subpage-card platform-card svc-platform-card">
    <div class="platform-head"><div class="h3">Choose a <b>Platform</b></div></div>
    <div class="platform-grid svc-platform-grid {% if site['rtl'] %}rtl-nav{% endif %}" id="svc-platform-grid">

      <button type="button" class="pulse-platform-chip is-active" data-filter-platform="all">
        <span class="platform-icon platform-all"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg></span>
        <span class="platform-name">All</span>
      </button>
      <button type="button" class="pulse-platform-chip" data-filter-platform="Telegram">
        <span class="platform-icon platform-tg"><svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M21.95 4.27 18.7 19.6c-.24 1.08-.88 1.35-1.78.84l-4.92-3.63-2.37 2.28c-.26.26-.48.48-.99.48l.36-5.05 9.18-8.3c.4-.36-.09-.55-.62-.2L6.21 13.16 1.32 11.62c-1.06-.33-1.08-1.06.22-1.57l19.12-7.37c.88-.33 1.65.2 1.29 1.59z"/></svg></span>
        <span class="platform-name">Telegram</span>
      </button>
      <button type="button" class="pulse-platform-chip" data-filter-platform="Instagram">
        <span class="platform-icon platform-ig"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg></span>
        <span class="platform-name">Instagram</span>
      </button>
      <button type="button" class="pulse-platform-chip" data-filter-platform="TikTok">
        <span class="platform-icon platform-tiktok"><svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.3 0 .59.04.88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5.8 20.1a6.34 6.34 0 0 0 10.86-4.43V8.93a8.16 8.16 0 0 0 4.77 1.52V7a4.85 4.85 0 0 1-1.84-.31z"/></svg></span>
        <span class="platform-name">TikTok</span>
      </button>
      <button type="button" class="pulse-platform-chip" data-filter-platform="Twitter">
        <span class="platform-icon platform-x"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></span>
        <span class="platform-name">X / Twitter</span>
      </button>
      <button type="button" class="pulse-platform-chip" data-filter-platform="YouTube">
        <span class="platform-icon platform-yt"><svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z"/></svg></span>
        <span class="platform-name">Youtube</span>
      </button>
      <button type="button" class="pulse-platform-chip" data-filter-platform="Facebook">
        <span class="platform-icon platform-fb"><svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg></span>
        <span class="platform-name">Facebook</span>
      </button>
      <button type="button" class="pulse-platform-chip" data-filter-platform="Twitch">
        <span class="platform-icon platform-twitch"><svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714z"/></svg></span>
        <span class="platform-name">Twitch</span>
      </button>
      <button type="button" class="pulse-platform-chip" data-filter-platform="Discord">
        <span class="platform-icon platform-discord"><svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.01.022.023.042.042.052a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg></span>
        <span class="platform-name">Discord</span>
      </button>
      <button type="button" class="pulse-platform-chip" data-filter-platform="Spotify">
        <span class="platform-icon platform-spotify"><svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg></span>
        <span class="platform-name">Spotify</span>
      </button>

      {# Extra platforms — revealed by "More" #}
      <button type="button" class="pulse-platform-chip svc-extra is-row-hidden" data-filter-platform="LinkedIn">
        <span class="platform-icon platform-li"><svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></span>
        <span class="platform-name">LinkedIn</span>
      </button>
      <button type="button" class="pulse-platform-chip svc-extra is-row-hidden" data-filter-platform="Pinterest">
        <span class="platform-icon platform-pin"><svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M12.017 0C5.396 0 .029 5.367.029 11.987c0 5.079 3.158 9.417 7.618 11.162-.105-.949-.199-2.403.041-3.439.219-.937 1.406-5.957 1.406-5.957s-.359-.72-.359-1.781c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12.017 24c6.624 0 11.99-5.367 11.99-11.988C24.007 5.367 18.641 0 12.017 0z"/></svg></span>
        <span class="platform-name">Pinterest</span>
      </button>
      <button type="button" class="pulse-platform-chip svc-extra is-row-hidden" data-filter-platform="Google">
        <span class="platform-icon platform-google"><svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor"><path d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z"/></svg></span>
        <span class="platform-name">Google</span>
      </button>
      <button type="button" class="pulse-platform-chip svc-extra is-row-hidden" data-filter-platform="__other__">
        <span class="platform-icon platform-other"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v8"/><path d="M8 12h8"/></svg></span>
        <span class="platform-name">Other</span>
      </button>

      {# More / Less toggle chip #}
      <button type="button" class="platform-more-chip" id="svc-more-toggle" aria-expanded="false">
        <span class="platform-icon"><svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/></svg></span>
        <span class="platform-name" data-more-label>More</span>
      </button>
    </div>
  </div>

  {# ─── Search ─── #}
  <div class="svc-searchbar">
    <svg class="svc-searchbar-ic" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
    <input type="text" class="svc-search__input" placeholder="{{ lang('general.search.placeholder') }}" data-search-service="#service-table" autocomplete="off">
  </div>

  {# Hidden legacy dropdown — keeps Perfect Panel category-filter JS working #}
  <div aria-hidden="true" style="display:none">
    <ul class="nav nav-pills services-toolbar-left">
      <li>
        <div class="dropdown">
          <button class="btn btn-secondary dropdown-toggle services-filter-btn" data-toggle="dropdown">
            <span class="services-filter-label" data-filter-default-label="{{ lang('services.all') }}">
              <span class="services-filter-default">{{ lang('services.all') }}</span>
              <span data-filter-active-category="true"></span>
            </span>
          </button>
          <ul class="dropdown-menu dropdown-max-height">
            {% if serviceCategoryList is not empty %}
              <li><a class="dropdown-item" href="#" data-filter-category-id="All">{{ lang('services.all') }}</a></li>
            {% endif %}
            {% for category in serviceCategoryList %}
              {% if category.name %}
                <li><a class="dropdown-item" href="#" data-filter-category-id="{{ category.id }}" data-filter-category-name="{{ category.name }}"><span>{{ category['name'] }}</span></a></li>
              {% endif %}
            {% endfor %}
          </ul>
        </div>
      </li>
    </ul>
  </div>

  {# ─── Services table ─── #}
  <div class="subpage-card subpage-card--flush services-card">
    <div class="svc-card-head" id="svc-card-head">
      <span class="svc-card-head-ic">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M21.95 4.27 18.7 19.6c-.24 1.08-.88 1.35-1.78.84l-4.92-3.63-2.37 2.28c-.26.26-.48.48-.99.48l.36-5.05 9.18-8.3c.4-.36-.09-.55-.62-.2L6.21 13.16 1.32 11.62c-1.06-.33-1.08-1.06.22-1.57l19.12-7.37c.88-.33 1.65.2 1.29 1.59z"/></svg>
      </span>
      <span class="svc-card-head-title"><b id="svc-card-platform">All</b> Services</span>
      <button type="button" class="svc-card-head-caret" id="svc-card-collapse" aria-label="Collapse">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
      </button>
    </div>
    <div class="svc-table-wrap" id="svc-table-wrap">
      <table class="svc-table {% if site['rtl'] %}rtl-table{% endif %}" id="service-table">
        <thead>
          <tr>
            <th class="svc-c-id">{{ lang('services.id') }}</th>
            {% if user.favorite_services %}<th class="svc-c-fav">Fav</th>{% endif %}
            <th class="svc-c-name">{{ lang('services.name') }}</th>
            <th class="svc-c-mm nowrap">Min / Max</th>
            <th class="svc-c-rate nowrap">Cost per K</th>
            {% if serviceDescription %}<th class="svc-c-desc">{{ lang('services.description') }}</th>{% endif %}
            <th class="svc-c-order"></th>
          </tr>
        </thead>
        <tbody>
          {% for category in serviceCategoryList %}
            {% if category['name'] %}
              <tr class="svc-cat-row" data-filter-table-category-id="{{ category.id }}">
                <td colspan="100%">
                  <div class="svc-cat-head" data-cat-toggle="{{ category.id }}">
                    {% if category['icon'] and category['icon']['icon_type'] == 'emoji' %}
                      <span class="svc-cat-emoji">{{ category['icon']['icon'] }}</span>
                    {% elseif category['icon'] and category['icon']['icon_type'] == 'image' %}
                      <img src="{{ category['icon']['url'] }}" alt="" class="cat-icon-img">
                    {% endif %}
                    <strong>{{ category['name'] }}</strong>
                    <svg class="svc-cat-caret" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
                  </div>
                </td>
              </tr>
            {% endif %}
            {% for service in category['services'] %}
              <tr data-filter-table-category-id="{{ category.id }}">
                <td class="tabular svc-c-id" data-filter-table-service-id="{{ service.id }}">{{ service['id'] }}</td>
                {% if user.favorite_services %}
                  <td class="svc-c-fav">
                    <span role="button" class="fav-toggle {% if service.favorite %}favorite-active{% endif %}" data-favorite-service-id="{{ service.id }}" aria-label="{{ lang('services.favorite') }}">
                      <span data-favorite-icon class="{% if service.favorite %}fas fa-star{% else %}far fa-star{% endif %}"></span>
                    </span>
                  </td>
                {% endif %}
                <td class="svc-name svc-c-name" data-filter-table-service-name="true">{{ service['name'] }}</td>
                <td class="tabular muted svc-c-mm nowrap">{{ service['min'] }} - {{ service['max'] }}</td>
                <td class="tabular svc-c-rate nowrap">
                  {% if converted %}<span data-toggle="tooltip" title="{{ service.original_rate }}">{{ service.rate }}</span>{% else %}{{ service.rate }}{% endif %}
                </td>
                {% if serviceDescription %}
                  <td class="svc-c-desc"><span class="desc-text">{{ service['description']|default('Description will be shown here') }}</span><svg class="svc-desc-caret" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg></td>
                {% endif %}
                <td class="svc-c-order">
                  {% if user.auth %}
                    <a href="{{ page_url('neworder') }}?service={{ service['id'] }}" class="svc-order-btn" title="Order this service">{{ lang('services.button.order')|default('Order') }}
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                    </a>
                  {% else %}
                    <a href="{{ page_url('signup') }}?ref=svc-{{ service['id'] }}" class="svc-order-btn" title="Sign up to order">{{ lang('services.button.order')|default('Order') }}
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                    </a>
                  {% endif %}
                </td>
              </tr>
              {% if serviceDescription and service['description'] %}
                <tr data-filter-table-category-id="{{ category.id }}" class="visible-xs visible-sm service-description-mobile">
                  <td colspan="100%">{{ service['description'] }}</td>
                </tr>
              {% endif %}
            {% endfor %}
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

</div>

{% if servicesText %}
  <div class="services-text-wrap" style="display:none">
    <div class="services-text {% if site['rtl'] %}rtl-content{% endif %}">{{ servicesText }}</div>
  </div>
{% endif %}

<script>
(function(){
  var PLATFORM_MAP = [
    { name: 'Telegram', keywords: ['telegram', 'tg '] },
    { name: 'Instagram', keywords: ['instagram'] },
    { name: 'Twitter', keywords: ['twitter', 'x /', ' x '] },
    { name: 'TikTok', keywords: ['tiktok'] },
    { name: 'YouTube', keywords: ['youtube'] },
    { name: 'Facebook', keywords: ['facebook'] },
    { name: 'LinkedIn', keywords: ['linkedin'] },
    { name: 'Pinterest', keywords: ['pinterest'] },
    { name: 'Spotify', keywords: ['spotify'] },
    { name: 'Discord', keywords: ['discord'] },
    { name: 'Twitch', keywords: ['twitch'] },
    { name: 'Google', keywords: ['google'] }
  ];
  var serviceTable = document.getElementById('service-table');
  if (!serviceTable) return;

  // Map categories → platform
  var catRowEls = serviceTable.querySelectorAll('.svc-cat-row');
  var catToPlatform = {};
  catRowEls.forEach(function(row){
    var name = (row.querySelector('strong')||{}).textContent || '';
    var nl = name.toLowerCase();
    var plat = '__other__';
    for (var i=0;i<PLATFORM_MAP.length;i++){ if (PLATFORM_MAP[i].keywords.some(function(k){return nl.indexOf(k)!==-1;})) { plat = PLATFORM_MAP[i].name; break; } }
    catToPlatform[row.getAttribute('data-filter-table-category-id')] = plat;
  });

  // Group service rows by category
  var svcRowsByCat = {};
  serviceTable.querySelectorAll('tbody > tr[data-filter-table-category-id]').forEach(function(row){
    if (row.classList.contains('svc-cat-row')) return;
    var cid = row.getAttribute('data-filter-table-category-id');
    (svcRowsByCat[cid] = svcRowsByCat[cid] || []).push(row);
  });

  var chips = document.querySelectorAll('.pulse-platform-chip[data-filter-platform]');
  var currentPlatform = 'all';

  var platformLabel = document.getElementById('svc-card-platform');
  var collapsedCats = {};

  function applyPlatform(platform){
    currentPlatform = platform;
    chips.forEach(function(c){ c.classList.toggle('is-active', c.getAttribute('data-filter-platform')===platform); });
    if (platformLabel) {
      var active = document.querySelector('.pulse-platform-chip.is-active .platform-name');
      platformLabel.textContent = (platform === 'all') ? 'All' : (active ? active.textContent : platform);
    }
    catRowEls.forEach(function(catRow){
      var cid = catRow.getAttribute('data-filter-table-category-id');
      var plat = catToPlatform[cid] || '__other__';
      var match = platform === 'all' || plat === platform;
      catRow.style.display = match ? '' : 'none';
      var rows = svcRowsByCat[cid] || [];
      var show = match && !collapsedCats[cid];
      rows.forEach(function(r){ if (!r.classList.contains('service-description-mobile')) r.style.display = show ? '' : 'none'; });
    });
    var si = document.querySelector('.svc-search__input'); if (si) si.value = '';
  }

  chips.forEach(function(chip){ chip.addEventListener('click', function(){ applyPlatform(chip.getAttribute('data-filter-platform')); }); });

  // More / Less
  var moreToggle = document.getElementById('svc-more-toggle');
  var extras = document.querySelectorAll('.svc-extra');
  if (moreToggle){
    moreToggle.addEventListener('click', function(){
      var open = moreToggle.getAttribute('aria-expanded') === 'true';
      extras.forEach(function(e){ e.classList.toggle('is-row-hidden', open); });
      moreToggle.setAttribute('aria-expanded', open ? 'false':'true');
      var lbl = moreToggle.querySelector('[data-more-label]'); if (lbl) lbl.textContent = open ? 'More' : 'Less';
    });
  }

  // Search
  function applySearch(query){
    var q = (query||'').toLowerCase();
    if (!q){ applyPlatform(currentPlatform); return; }
    catRowEls.forEach(function(catRow){
      var cid = catRow.getAttribute('data-filter-table-category-id');
      var rows = svcRowsByCat[cid] || []; var hit = false;
      rows.forEach(function(r){
        if (r.classList.contains('service-description-mobile')) { r.style.display='none'; return; }
        var nameEl = r.querySelector('[data-filter-table-service-name]');
        var idEl = r.querySelector('[data-filter-table-service-id]');
        var m = (nameEl && nameEl.textContent.toLowerCase().indexOf(q)!==-1) || (idEl && idEl.textContent.indexOf(q)!==-1);
        r.style.display = m ? '' : 'none'; if (m) hit = true;
      });
      catRow.style.display = hit ? '' : 'none';
    });
  }
  var searchInput = document.querySelector('.svc-search__input');
  if (searchInput){ var t; searchInput.addEventListener('input', function(){ clearTimeout(t); var v = searchInput.value.trim(); t = setTimeout(function(){ applySearch(v); }, 120); }); }

  // Collapsible category groups
  document.querySelectorAll('[data-cat-toggle]').forEach(function(head){
    head.addEventListener('click', function(){
      var cid = head.getAttribute('data-cat-toggle');
      collapsedCats[cid] = !collapsedCats[cid];
      head.classList.toggle('is-collapsed', collapsedCats[cid]);
      (svcRowsByCat[cid] || []).forEach(function(r){
        if (r.classList.contains('service-description-mobile')) return;
        r.style.display = collapsedCats[cid] ? 'none' : '';
      });
    });
  });

  // Collapse whole table
  var collapseBtn = document.getElementById('svc-card-collapse');
  var tableWrap = document.getElementById('svc-table-wrap');
  if (collapseBtn && tableWrap){
    collapseBtn.addEventListener('click', function(){
      var open = tableWrap.style.display !== 'none';
      tableWrap.style.display = open ? 'none' : '';
      collapseBtn.classList.toggle('is-collapsed', open);
    });
  }

  // Description expand (desktop)
  document.addEventListener('click', function(e){
    if (e.target.closest('.fav-toggle')) return;
    if (e.target.closest('[data-cat-toggle]')) return;
    var cell = e.target.closest('.svc-c-desc');
    if (cell){ cell.closest('tr').classList.toggle('is-desc-open'); }
  });
})();
</script>
