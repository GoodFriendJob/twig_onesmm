/* ── Collapsible sidebar groups ── */
(function(){
  document.addEventListener('click', function(e){
    var head = e.target.closest('.sidebar-group-head');
    if (!head) return;
    var group = head.closest('.sidebar-group');
    if (!group) return;
    var collapsed = group.classList.toggle('is-collapsed');
    head.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
  });
})();

/* ── Sidebar rail collapse (desktop) — persists to localStorage ── */
(function(){
  var shell = document.getElementById('app-shell');
  if (!shell) return;
  document.addEventListener('click', function(e){
    if (!e.target.closest('#pulse-sidebar-collapse')) return;
    var rail = shell.classList.toggle('is-rail');
    try { localStorage.setItem('pulse-rail', rail ? '1' : '0'); } catch(err) {}
  });
})();

/* ── Dark mode toggle ── */
(function(){
  function applyTheme(t) {
    document.documentElement.setAttribute('data-theme', t);
    try { localStorage.setItem('pulse-theme', t); } catch(e) {}
  }
  function toggleTheme() {
    var current = document.documentElement.getAttribute('data-theme');
    var next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.classList.add('theme-transitioning');
    applyTheme(next);
    setTimeout(function(){ document.documentElement.classList.remove('theme-transitioning'); }, 300);
  }
  document.addEventListener('click', function(e){
    if (e.target.closest('.theme-toggle')) toggleTheme();
  });
  try {
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e){
      if (!localStorage.getItem('pulse-theme')) {
        applyTheme(e.matches ? 'dark' : 'light');
      }
    });
  } catch(e) {}
})();


</script>
