</head>
<body class="theme-pulse {% if site['rtl'] %}rtl{% endif %}">

{% if user['auth'] %}
  {# ───────────── Authenticated app shell ───────────── #}
  <div class="app">

    {# ─── Sidebar (replaces horizontal navbar.navbar-left-block) ─── #}
    <aside class="sidebar">
      <a href="{{ page_url('index') }}" class="sidebar-brand">
        {% if site['logo'] %}
          <img src="{{ site['logo'] }}" alt="{{ site['name'] }}" title="{{ site['name'] }}">
        {% else %}
          <span class="brand-logo-combo">
            <img src="https://storage.perfectcdn.com/aedutt/bw77pj1h9ga51qfs.svg" alt="" class="brand-logo-icon" aria-hidden="true">
            <img src="https://storage.perfectcdn.com/aedutt/zi4z1ahe8mr69yfl.svg" alt="OneSMM" class="brand-logo-text">
          </span>
        {% endif %}
      </a>

      <nav class="sidebar-nav">
        {% for menu in site['menu'] %}
          {% set _ml = menu['link'] %}
          <a href="{{ _ml }}"
             class="sidebar-item {% if menu['active'] %}active{% endif %}"
             {% if menu['external'] %}target="_blank" rel="noopener"{% endif %}>
            {% if '/neworder' in _ml %}
              <svg class="mi" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z"/><path d="M14 3v4a1 1 0 0 0 1 1h4"/><path d="M12 12v5"/><path d="M9.5 14.5 12 12l2.5 2.5"/></svg>
            {% elseif '/massorder' in _ml or 'mass-order' in _ml or 'mass_order' in _ml %}
              <svg class="mi" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="12" height="13" rx="2"/><path d="M7 5h12a2 2 0 0 1 2 2v12"/><path d="M9 12h6"/><path d="M9 15h4"/></svg>
            {% elseif '/services' in _ml %}
              <svg class="mi" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><path d="M17.5 14v7"/><path d="M14 17.5h7"/></svg>
            {% elseif '/orders' in _ml %}
              <svg class="mi" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="m9 14 2 2 4-5"/></svg>
            {% elseif '/addfunds' in _ml %}
              <svg class="mi" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12V8a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h6"/><path d="M2 10h20"/><circle cx="19" cy="18" r="3"/><path d="M19 16.5v3"/><path d="M17.5 18h3"/></svg>
            {% elseif '/api' in _ml %}
              <svg class="mi" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m7 8-4 4 4 4"/><path d="m17 8 4 4-4 4"/><path d="m14 4-4 16"/></svg>
            {% elseif '/tickets' in _ml or '/support' in _ml %}
              <svg class="mi" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"/><path d="M8 10h8"/><path d="M8 13h5"/></svg>
            {% elseif '/subscriptions' in _ml %}
              <svg class="mi" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3v4a1 1 0 0 0 1 1h3"/><path d="M21 8v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h12l4 4Z"/><path d="M12 11v5"/><path d="M9 14h6"/></svg>
            {% elseif '/drip' in _ml %}
              <svg class="mi" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C8 7.5 5 10.5 5 14.5a7 7 0 0 0 14 0C19 10.5 16 7.5 12 2Z"/><path d="M12 22v-3"/><path d="M8 19c0-2.2 1.8-4 4-4"/></svg>
            {% elseif '/refill' in _ml %}
              <svg class="mi" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 15-6.7"/><path d="M21 12a9 9 0 0 1-15 6.7"/><path d="M18 2v4h-4"/><path d="M6 22v-4h4"/></svg>
            {% elseif '/refund' in _ml %}
              <svg class="mi" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h12a4 4 0 0 1 0 8h-3"/><path d="m6 10-3-3 3-3"/><path d="M14 18h2a4 4 0 0 0 3.46-2"/></svg>
            {% elseif '/blog' in _ml or '/updates' in _ml %}
              <svg class="mi" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5Z"/><path d="M8 7h8"/><path d="M8 11h5"/></svg>
            {% elseif '/faq' in _ml %}
              <svg class="mi" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.1 9a3 3 0 0 1 5.82 1c0 2-3 2.5-3 5"/><circle cx="12" cy="19" r=".5" fill="currentColor"/></svg>
            {% elseif '/account' in _ml or '/profile' in _ml %}
              <svg class="mi" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M5.5 21a6.5 6.5 0 0 1 13 0"/><path d="M15 12l2.5 2"/></svg>
            {% elseif '/child' in _ml %}
              <svg class="mi" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            {% else %}
              <svg class="mi" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
            {% endif %}
            <span class="sidebar-label">{{ menu['name'] }}</span>
          </a>
        {% endfor %}
      </nav>

      <div class="sidebar-greeting" id="sidebar-greeting" style="display:none">
        <span class="sidebar-greeting-wave">👋</span>
        <span class="sidebar-greeting-text">Welcome back, {{ user['username'] }}</span>
      </div>
      <script>
        (function(){
          var el=document.getElementById('sidebar-greeting');
          if(el && localStorage.getItem('onesmm_has_orders')){el.style.display='';}
        })();
      </script>

    </aside>

    {# ─── Mobile sidebar trigger + backdrop ─── #}
    <div class="sidebar-backdrop" id="pulse-sidebar-backdrop" aria-hidden="true"></div>

    {# ─── Main column: topbar + content ─── #}
    <div class="app-main">

      <header class="topbar" id="navbar">
        {# Hamburger sits inside the topbar, left of search (best-practice mobile layout).
           Toggles the sidebar drawer; PP's BS3 `data-toggle` removed because it targets
           the wrong element. JS handler is below, after the closing </body> region. #}
        <button type="button" class="navbar-toggle navbar-toggle-mobile collapsed"
                id="pulse-sidebar-toggle"
                aria-expanded="false" aria-controls="pulse-sidebar"
                aria-label="Toggle menu">
          <span class="sr-only">Toggle navigation</span>
          <span class="icon-bar"></span>
          <span class="icon-bar"></span>
          <span class="icon-bar"></span>
        </button>
        {# Search bar removed — not needed in panel nav #}

        <div class="topbar-spacer"></div>

        {# ── Compact icon row (right side of topbar) ── #}
        <div class="topbar-icons">

          {# Theme toggle #}
          <button type="button" class="topbar-icon-btn theme-toggle" aria-label="Toggle dark mode" title="Toggle theme">
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9z"/></svg>
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
          </button>

          {# Language — flag-only icon button #}
          {% if site['languages']|length > 1 %}
            <div class="topbar-lang dropdown">
              {% for l in site['languages'] %}{% if l['active'] %}
                <button class="topbar-icon-btn topbar-lang-btn" id="topbar-lang-btn" aria-haspopup="true" aria-expanded="false" aria-label="Change language" title="{{ l['name'] }}">
                  <span class="topbar-lang-flag">{{ lang_flags[l['name']]|default('🌐') }}</span>
                </button>
              {% endif %}{% endfor %}
              <ul class="dropdown-menu dropdown-menu-right">
                {% for l in site['languages'] %}
                  <li {% if l['active'] %}class="active"{% endif %}><a href="{{ l['url'] }}">{{ lang_flags[l['name']]|default('🌐') }} {{ l['name'] }}</a></li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}

          {# Balance / currency — compact pill with amount only #}
          {% for menu in site['account_menu'] %}
            {% if not menu['link'] %}
              {% if site.currencies %}
                <div class="dropdown dropdown-currencies">
                  <button class="topbar-balance-btn" aria-haspopup="true" aria-expanded="false" title="Balance & currency">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M3 7a2 2 0 0 1 2-2h14v3"/><path d="M3 7v12a2 2 0 0 0 2 2h16V10H5a2 2 0 0 1-2-2"/>
                    </svg>
                    <span class="topbar-balance-amount tabular">{{ user.balance_formatted }}</span>
                  </button>
                  <ul class="dropdown-menu dropdown-menu-right" id="currencies-list">
                    {% for key, rate in site.currencies %}
                      <li>
                        <a href="#" id="currencies-item" data-rate-key="{{ key }}" data-rate-symbol="{{ rate.symbol }}">
                          <span class="tabular">{{ key }}</span>
                          <span class="muted">{{ rate.symbol }}</span>
                        </a>
                      </li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}
            {% endif %}
          {% endfor %}

          {# Divider #}
          <span class="topbar-divider"></span>

          {# Account & Logout — icon-only #}
          {% for menu in site['account_menu'] %}
            {% if menu['link'] %}
              {% set _is_logout = 'logout' in menu['link']|lower or 'signout' in menu['link']|lower %}
              <a href="{{ menu['link'] }}" class="topbar-icon-btn {% if menu['active'] %}is-active{% endif %}"
                 {% if menu['external'] %}target="_blank" rel="noopener"{% endif %}
                 aria-label="{{ menu['name'] }}" title="{{ menu['name'] }}">
                {% if _is_logout %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                {% else %}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                {% endif %}
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </header>

      <main class="app-content">
        {# ─── Welcome strip (hidden once user has placed orders) ─── #}
        <div class="welcome-strip" id="welcome-strip" style="display:none">
          <div class="welcome-strip-left">
            <h2 class="welcome-strip-greeting">
              Welcome back, <span class="welcome-strip-user">{{ user['username'] }}</span>
            </h2>
            <p class="welcome-strip-sub">What would you like to do today?</p>
          </div>
          <div class="welcome-strip-actions">
            {% if page['url'] != page_url('neworder') and '/neworder' not in _page_path %}
            <a href="{{ page_url('neworder') }}" class="welcome-strip-btn welcome-strip-btn--primary">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
              New Order
            </a>
            {% endif %}
            {% if user.balance_formatted matches '/^[^\\d]*0[.,]?0*$/' %}
            <a href="{{ page_url('addfunds') }}" class="welcome-strip-btn welcome-strip-btn--secondary">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"/><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"/><path d="M18 12a2 2 0 0 0 0 4h4v-4Z"/></svg>
              Add Funds
            </a>
            {% endif %}
          </div>
        </div>
        <script>
          (function(){
            var el=document.getElementById('welcome-strip');
            if(!el)return;
            if(!localStorage.getItem('onesmm_has_orders')){el.style.display='';}
          })();
        </script>

        {{ content }}
      </main>
    </div>
  </div>

{% else %}
  {# ───────────── Public / unauthenticated shell ───────────── #}
  {% set _is_auth_page = (page['title']|lower in ['sign up', 'signup', 'register', 'registration']) or ('/signup' in _page_path) or ('/register' in _page_path) %}

  {# ── Announcement bar ── #}
  <div class="pn-announce" id="pn-announce">
    <div class="pn-announce__inner">
      <span class="pn-announce__text">
        <svg class="pn-announce__icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        Free trials available — no signup needed
      </span>
      <a class="pn-announce__link" href="#free-trials">Try now &rarr;</a>
      <button class="pn-announce__close" aria-label="Dismiss" onclick="this.closest('.pn-announce').remove()">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>

  <nav class="navbar navbar-default navbar-static-top public-navbar {% if site['rtl'] %}rtl-navbar{% endif %}" id="pn-nav">
    <div class="container">
      <div class="navbar-header">
        <a class="navbar-brand" href="{{ page_url('index') }}">
          {% if site['logo'] %}
            <img src="{{ site['logo'] }}" alt="{{ site['name'] }}">
          {% else %}
            <span class="brand-logo-combo">
              <img src="https://storage.perfectcdn.com/aedutt/bw77pj1h9ga51qfs.svg" alt="" class="brand-logo-icon" aria-hidden="true">
              <img src="https://storage.perfectcdn.com/aedutt/zi4z1ahe8mr69yfl.svg" alt="OneSMM" class="brand-logo-text">
            </span>
          {% endif %}
        </a>
        {# Mobile-only theme toggle — sits next to hamburger #}
        <button type="button" class="theme-toggle theme-toggle--mobile" aria-label="Toggle dark mode">
          <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9z"/></svg>
          <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
        </button>
        {# Mobile-only language switcher — globe icon next to theme toggle #}
        {% if site['languages']|length > 1 %}
          <div class="lang-mobile-wrap" id="lang-mobile-wrap">
            <button type="button" class="lang-mobile-btn" id="lang-mobile-btn" aria-label="Change language" aria-haspopup="true" aria-expanded="false">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            </button>
            <ul class="lang-mobile-menu" id="lang-mobile-menu" style="display:none !important">
              {% for l in site['languages'] %}
                <li {% if l['active'] %}class="active"{% endif %}><a href="{{ l['url'] }}">{{ lang_flags[l['name']]|default('🌐') }} {{ l['name'] }}</a></li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}
        <button type="button" class="public-menu-toggle" aria-label="Toggle navigation" aria-expanded="false">
          <span class="public-menu-toggle__bar"></span>
          <span class="public-menu-toggle__bar"></span>
          <span class="public-menu-toggle__bar"></span>
        </button>
      </div>

      <div id="public-navbar" class="collapse navbar-collapse">


        {# ── Services mega-dropdown + nav links ── #}
        <ul class="nav navbar-nav pn-nav-links">
          <li class="pn-services-drop" id="pn-services-drop">
            <button class="pn-services-trigger" type="button" aria-expanded="false" aria-haspopup="true">
              Services
              <svg class="pn-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="pn-mega" id="pn-mega" aria-hidden="true">
              <div class="pn-mega__head">
                <span class="pn-mega__title">SMM Services by Platform</span>
                <a class="pn-mega__all" href="{{ page_url('services') }}">Browse all 5,000+ &rarr;</a>
              </div>
              <div class="pn-mega__grid">
                <a href="/instagram-smm-panel" class="pn-mega__card">
                  <span class="pn-mega__icon" style="background:linear-gradient(135deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888)">
