{% macro navItem(item) %}
  {% import _self as nav %}
  <a href="{{ item['link'] }}"
     class="sidebar-item {% if item['active'] %}active{% endif %}"
     {% if item['external'] %}target="_blank" rel="noopener"{% endif %}>
    {{ nav.navIcon(item['link']) }}
    <span class="sidebar-label">{{ item['name'] }}</span>
  </a>
{% endmacro %}

<!DOCTYPE html>
<html lang="{{ site['iso_lang_code'] }}" {% if site['rtl'] %}dir="rtl"{% endif %} data-theme="light">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  {# ── Title: "Page Name | Site Name" or just "Site Name" for homepage/signin ── #}
  {% set _page_path_raw = page['url']|split('?')|first %}
  {% set _page_path_check = page['url']|split('?')|first %}
  {% if '/our-story' in _page_path_check %}
    {% set _seo_title = 'Our Story — About OneSMM | The SMM Panel Built Different' %}
  {% elseif '/careers' in _page_path_check %}
    {% set _seo_title = 'Careers at OneSMM — Join the Team | OneSMM' %}
  {% elseif page['title'] and page['title']|lower not in ['sign in', 'signin', 'login'] %}
    {% set _seo_title = page['title'] ~ ' | ' ~ site['name'] %}
  {% else %}
    {% set _seo_title = site['name'] ~ ' — Cheapest SMM Panel 2026 | Followers, Members & Views' %}
  {% endif %}
  <title>{{ _seo_title }}</title>
  {# ── Per-page meta keywords ── #}
  {% set _page_path = page['url']|split('?')|first %}
  {% if '/our-story' in _page_path %}
    {% set _seo_keys = 'about onesmm, smm panel story, onesmm mission, social media marketing panel, who is onesmm, onesmm about us' %}
  {% elseif '/careers' in _page_path %}
    {% set _seo_keys = 'onesmm careers, smm panel jobs, social media marketing jobs, work at onesmm, onesmm hiring, remote smm jobs' %}
