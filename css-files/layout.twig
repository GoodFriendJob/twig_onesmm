  <meta name="description" content="{{ _seo_desc }}">

  {# ── Canonical URL ── #}
  {% if page['url'] %}
    <link rel="canonical" href="{{ page['url'] }}">
  {% endif %}

  {# ── Open Graph ── #}
  <meta property="og:type" content="website">
  {% if page['url'] %}<meta property="og:url" content="{{ page['url'] }}">{% endif %}
  <meta property="og:site_name" content="{{ site['name'] }}">
  <meta property="og:title" content="{{ _seo_title }}">
  <meta property="og:description" content="{{ _seo_desc }}">
  {% if site['logo'] %}<meta property="og:image" content="{{ site['logo'] }}">{% endif %}

  {# ── Twitter / X Card ── #}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ _seo_title }}">
  <meta name="twitter:description" content="{{ _seo_desc }}">
  {% if site['logo'] %}<meta name="twitter:image" content="{{ site['logo'] }}">{% endif %}

  {# ── JSON-LD: Organization ── #}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ site['name']|json_encode }},
    "url": "https://onesmm.com",
    "logo": {{ site['logo']|json_encode }},
    "description": "Cheapest SMM panel with 5,000+ services across 32+ platforms. Buy Instagram followers, Telegram members, YouTube subscribers and more at wholesale prices.",
    "sameAs": [
      "https://t.me/onesmmcom"
    ],
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "Customer Support",
      "email": "support@onesmm.com",
      "availableLanguage": ["English"]
    }
  }
  </script>

  {# ── JSON-LD: WebSite + SearchAction (enables sitelinks search box in SERP) ── #}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ site['name']|json_encode }},
    "url": "https://onesmm.com",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://onesmm.com/services?search={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }
  </script>

  {# ── JSON-LD: BreadcrumbList (all pages) ── #}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://onesmm.com/"
      }
      {% if '/blog/' in _page_path %}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": "Blog",
        "item": "https://onesmm.com/blog"
      }
      ,{
        "@type": "ListItem",
        "position": 3,
        "name": "{{ page['title'] }}",
        "item": "https://onesmm.com{{ _page_path }}"
      }
      {% elseif _page_path != '/' and _page_path != '' and page['title']|lower not in ['sign in', 'signin', 'login'] %}
      ,{
        "@type": "ListItem",
        "position": 2,
        "name": "{{ page['title'] }}",
        "item": "https://onesmm.com{{ _page_path }}"
      }
      {% endif %}
    ]
  }
  </script>

  {# ── JSON-LD: Person (blog author — GEO authority signal) ── #}
  {% if '/blog/' in _page_path %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "OneSMM Editorial",
    "jobTitle": "Marketing &amp; Growth Team",
    "worksFor": {
      "@type": "Organization",
      "name": {{ site['name']|json_encode }},
      "url": "https://onesmm.com"
    },
    "url": "https://onesmm.com/our-story",
    "description": "SMM industry analysts covering social media growth strategies, panel mechanics, and platform-specific marketing across Instagram, Telegram, YouTube, TikTok, and Twitter/X."
  }
  </script>
