  'العربية': '🇸🇦', 'Español': '🇪🇸', 'ไทย': '🇹🇭', 'Tiếng Việt': '🇻🇳',
  'Deutsch': '🇩🇪', '日本語': '🇯🇵', 'Polski': '🇵🇱', 'Українська': '🇺🇦',
  'فارسی': '🇮🇷', 'Português': '🇧🇷', 'Français': '🇫🇷', '中文': '🇨🇳',
