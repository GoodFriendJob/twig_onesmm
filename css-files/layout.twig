{# layout.twig — Pulse theme for Perfect Panel
   Drop-in replacement: same variable contract as the default layout.
   Companion CSS: assets/css/theme.css (port from styles.css)

   Uses ALL the existing globals:
     site.iso_lang_code, site.rtl, site.favicon, site.logo, site.name
     site.seo_key, site.seo_desc, site.custom_header, site.custom_footer
     site.styles[], site.scripts[]
     site.menu[]          → main nav (each: name, link, icon, active, external)
     site.account_menu[]  → topbar nav (balance entry has no link, see {% if not menu.link %})
     site.languages[]     → each: name, url, active
     site.currencies      → { KEY: { symbol, ... } }
     user.auth, user.balance_formatted
     page.title
#}
