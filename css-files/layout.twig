<script>
(function(){
  // Delegate from document so the handler works even if PP rebuilds the topbar later.
  function getEls() {
    return {
      btn: document.getElementById('pulse-sidebar-toggle'),
      sidebar: document.querySelector('.sidebar'),
      backdrop: document.getElementById('pulse-sidebar-backdrop')
    };
  }
  function open(){
    var els = getEls();
    if (!els.sidebar || !els.backdrop) return;
    els.sidebar.classList.add('open');
    els.backdrop.classList.add('is-visible');
    if (els.btn) {
      els.btn.classList.add('is-open');
      els.btn.setAttribute('aria-expanded', 'true');
    }
    document.body.style.overflow = 'hidden';
  }
  function close(){
    var els = getEls();
    if (!els.sidebar || !els.backdrop) return;
    els.sidebar.classList.remove('open');
    els.backdrop.classList.remove('is-visible');
    if (els.btn) {
      els.btn.classList.remove('is-open');
      els.btn.setAttribute('aria-expanded', 'false');
    }
    document.body.style.overflow = '';
  }
  // Click delegation — works no matter when the button is in the DOM
  document.addEventListener('click', function(e){
    var trigger = e.target.closest('#pulse-sidebar-toggle');
    if (trigger) {
      e.preventDefault();
      e.stopPropagation();
      var els = getEls();
      if (els.sidebar && els.sidebar.classList.contains('open')) close(); else open();
      return;
    }
    if (e.target.closest('#pulse-sidebar-backdrop')) {
      close();
      return;
    }
    // Close drawer when a sidebar link is tapped on mobile
    var sidebar = document.querySelector('.sidebar');
    if (sidebar && sidebar.classList.contains('open') && e.target.closest('.sidebar a')) {
      close();
    }
  });
  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape') {
      var sidebar = document.querySelector('.sidebar');
      if (sidebar && sidebar.classList.contains('open')) close();
    }
  });
  window.addEventListener('resize', function(){
    var sidebar = document.querySelector('.sidebar');
    if (sidebar && window.innerWidth > 991 && sidebar.classList.contains('open')) close();
  });
})();

/* Public navbar hamburger toggle */
(function(){
  document.addEventListener('click', function(e){
    var btn = e.target.closest('.public-menu-toggle');
    if (!btn) return;
    e.preventDefault();
    var nav = document.getElementById('public-navbar');
    if (!nav) return;
    var open = nav.classList.toggle('public-nav-open');
    btn.classList.toggle('is-open', open);
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  window.addEventListener('resize', function(){
    if (window.innerWidth > 768) {
      var nav = document.getElementById('public-navbar');
      var btn = document.querySelector('.public-menu-toggle');
      if (nav) nav.classList.remove('public-nav-open');
      if (btn) { btn.classList.remove('is-open'); btn.setAttribute('aria-expanded','false'); }
    }
  });
})();

/* ── Navbar JS-sticky + scroll glassmorphism ── */
(function(){
  var nav = document.querySelector('.public-navbar');
  if (!nav) return;
  var shell = document.querySelector('.public-shell');
  var placeholder = document.createElement('div');
  placeholder.style.display = 'none';
  nav.parentNode.insertBefore(placeholder, nav.nextSibling);

  var stickyTop = nav.offsetTop;
  var navH = nav.offsetHeight;
  var isFixed = false;
  var last = -1;

  function onScroll(){
    var y = window.pageYOffset || document.documentElement.scrollTop;
    if (y === last) return;
    last = y;

    /* Glassmorphism effect */
    nav.classList.toggle('is-scrolled', y > 8);

    /* JS-based sticky: fix when scrolled past original position */
    if (y >= stickyTop && !isFixed) {
      isFixed = true;
      nav.classList.add('is-fixed');
      placeholder.style.display = 'block';
      placeholder.style.height = navH + 'px';
    } else if (y < stickyTop && isFixed) {
      isFixed = false;
      nav.classList.remove('is-fixed');
      placeholder.style.display = 'none';
    }
  }

  /* Recalculate sticky point on resize / announcement dismiss */
  function recalc(){
    if (isFixed) {
      nav.classList.remove('is-fixed');
      placeholder.style.display = 'none';
      isFixed = false;
    }
    stickyTop = nav.offsetTop;
    navH = nav.offsetHeight;
    onScroll();
  }

  window.addEventListener('scroll', onScroll, {passive:true});
  window.addEventListener('resize', recalc);
  new MutationObserver(recalc).observe(document.body, {childList:true, subtree:false});
  onScroll();
})();

/* ── Services mega-dropdown ── */
(function(){
  var drop = document.getElementById('pn-services-drop');
  var trigger = drop ? drop.querySelector('.pn-services-trigger') : null;
  var mega = document.getElementById('pn-mega');
  if (!drop || !trigger || !mega) return;

  var hoverTimeout;
  function open(){
    drop.classList.add('is-open');
    trigger.setAttribute('aria-expanded', 'true');
    mega.setAttribute('aria-hidden', 'false');
  }
  function close(){
    clearTimeout(hoverTimeout);
    drop.classList.remove('is-open');
    trigger.setAttribute('aria-expanded', 'false');
    mega.setAttribute('aria-hidden', 'true');
  }

  /* Desktop: hover open/close with slight delay */
  drop.addEventListener('mouseenter', function(){ clearTimeout(hoverTimeout); open(); });
  drop.addEventListener('mouseleave', function(){ hoverTimeout = setTimeout(close, 180); });

  /* Click toggle (touch / mobile fallback) */
  trigger.addEventListener('click', function(e){
    e.preventDefault();
    e.stopPropagation();
    drop.classList.contains('is-open') ? close() : open();
  });

  /* Close on outside click */
  document.addEventListener('click', function(e){
    if (!drop.classList.contains('is-open')) return;
    if (e.target.closest('#pn-services-drop')) return;
    close();
  });

  /* Close on Escape */
  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape' && drop.classList.contains('is-open')) close();
  });
})();

/* ── Mobile language dropdown ── */
(function(){
  var ready = false;
  setTimeout(function(){ ready = true; }, 600);
  var btn = document.getElementById('lang-mobile-btn');
  var menu = document.getElementById('lang-mobile-menu');
  function isOpen() { return menu && menu.style.getPropertyValue('display') === 'block'; }
  function show() { menu.style.setProperty('display','block','important'); btn.setAttribute('aria-expanded','true'); }
  function hide() { menu.style.setProperty('display','none','important'); btn.setAttribute('aria-expanded','false'); }
  if (btn && menu) {
    menu.style.setProperty('display','none','important');
    btn.addEventListener('click', function(e){
      if (!ready) return;
      e.preventDefault();
      e.stopPropagation();
      isOpen() ? hide() : show();
    });
  }
  document.addEventListener('click', function(e){
    if (!isOpen()) return;
    if (e.target.closest('#lang-mobile-wrap')) return;
    hide();
  });
})();

/* ── Topbar language dropdown (authenticated header) ── */
(function(){
  var wrap = document.querySelector('.topbar-lang');
  var btn  = document.getElementById('topbar-lang-btn');
  if (!btn || !wrap) return;
  btn.addEventListener('click', function(e){
    e.preventDefault();
    e.stopPropagation();
    wrap.classList.toggle('open');
    btn.setAttribute('aria-expanded', wrap.classList.contains('open') ? 'true' : 'false');
  });
  document.addEventListener('click', function(e){
    if (!wrap.classList.contains('open')) return;
    if (e.target.closest('.topbar-lang')) return;
    wrap.classList.remove('open');
    btn.setAttribute('aria-expanded', 'false');
  });
})();

