{# massorder.twig — Pulse styled
   Drop-in replacement: same variable contract.
   Variables: site.rtl, page.url, error, errorText, success, order,
              csrftoken, lang(...)
#}
<div class="massorder-page">

  <div class="massorder-grid">

    {# ─── LEFT: form ─── #}
    <div class="massorder-form">
      <div class="card">
        <div class="card-body">
          <form {% if site['rtl'] %}class="rtl-form"{% endif %} method="post" action="{{ page['url'] }}">
            <input type="hidden" name="_csrf" value="{{ csrftoken }}">

            {% if 1 == success %}
              <div class="alert alert-success alert-dismissible" role="alert">
                <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4>{{ lang('massorder.message.success') }}</h4>
                <div class="success-grid">
                  <span>{{ lang('massorder.orders') }}</span><span class="tabular">{{ order['success'] }}</span>
                  <span>{{ lang('massorder.errors') }}</span><span class="tabular">{{ order['error'] }}</span>
                </div>
                <a href="{{ order['link'] }}" target="_blank" class="btn btn-secondary btn-sm" style="margin-top: 12px;">
                  {{ lang('massorder.button.details') }}
                </a>
              </div>
            {% endif %}

            {% if error %}
              <div class="alert alert-dismissible alert-danger {% if site['rtl'] %}rtl-alert{% endif %}">
                <button type="button" class="close" data-dismiss="alert">&times;</button>
                {% if order['link'] %}
                  <h4>{{ errorText }}</h4>
                  <div class="success-grid">
                    <span>{{ lang('massorder.orders') }}</span><span class="tabular">{{ order['success'] }}</span>
                    <span>{{ lang('massorder.errors') }}</span><span class="tabular">{{ order['error'] }}</span>
                  </div>
                  <a href="{{ order['link'] }}" target="_blank" class="btn btn-secondary btn-sm" style="margin-top: 12px;">
                    {{ lang('massorder.button.details') }}
                  </a>
                {% else %}
                  {{ errorText }}
                {% endif %}
              </div>
            {% endif %}

            <div class="form-group">
              <label for="links" class="control-label">{{ lang('massorder.label') }}</label>
              <textarea class="form-control mono massorder-textarea" name="MassOrderForm[orders]" rows="15" id="links" placeholder="{{ lang('massorder.placeholder') }}"></textarea>
            </div>

            <button type="submit" class="btn btn-primary btn-lg">
              {{ lang('massorder.button') }}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </button>
          </form>
        </div>
      </div>
    </div>

    {# ─── RIGHT: format guide ─── #}
    <aside class="massorder-help">
      <div class="card">
        <div class="card-body">
          <div class="h3" style="margin: 0 0 12px;">Format</div>
          <p class="muted" style="font-size: 13px; margin: 0 0 12px;">One order per line. Use this exact format:</p>
          <pre class="format-pre">service_id|link|quantity</pre>
          <div class="h4" style="margin: 18px 0 8px; font-size: 13px;">Example</div>
          <pre class="format-pre">4287|https://instagram.com/profile|1000
5102|https://tiktok.com/@user/video/123|5000
6014|https://youtube.com/watch?v=abc|500</pre>

          <ul class="massorder-tips">
            <li>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              Find <strong>service IDs</strong> on the Services page
            </li>
            <li>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              Quantities must respect each service's min/max
            </li>
            <li>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
              Lines that fail are skipped — successful ones still go through
            </li>
          </ul>
        </div>
      </div>
    </aside>

  </div>
</div>
